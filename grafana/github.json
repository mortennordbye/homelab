{
  "uid": "github",
  "title": "GitHub",
  "tags": [
    "homelab",
    "github"
  ],
  "schemaVersion": 42,
  "editable": true,
  "graphTooltip": 1,
  "refresh": "15m",
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "repository",
        "label": "Repository",
        "type": "query",
        "datasource": {
          "type": "grafana-github-datasource",
          "uid": "github"
        },
        "query": {
          "queryType": "Repositories",
          "owner": "mortennordbye",
          "key": "name",
          "field": "name",
          "refId": "repos"
        },
        "current": {
          "text": "homelab",
          "value": "homelab"
        },
        "refresh": 1,
        "sort": 1,
        "hide": 0
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Merged",
      "datasource": {
        "type": "datasource",
        "uid": "-- Dashboard --"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "datasource",
            "uid": "-- Dashboard --"
          },
          "refId": "A",
          "panelId": 4,
          "withTransforms": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "count"
          ],
          "fields": "/^number$/",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "value",
        "wideLayout": true
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Open",
      "datasource": {
        "type": "grafana-github-datasource",
        "uid": "github"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-github-datasource",
            "uid": "github"
          },
          "refId": "A",
          "queryType": "Pull_Requests",
          "owner": "mortennordbye",
          "repository": "$repository",
          "options": {
            "query": "is:open",
            "timeField": 4
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "count"
          ],
          "fields": "/^number$/",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "value",
        "wideLayout": true
      },
      "description": "Open right now, regardless of the time range."
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Median time to merge",
      "datasource": {
        "type": "datasource",
        "uid": "-- Dashboard --"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "datasource",
            "uid": "-- Dashboard --"
          },
          "refId": "A",
          "panelId": 4,
          "withTransforms": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          },
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "median"
          ],
          "fields": "/^open_time$/",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "value",
        "wideLayout": true
      }
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Lines changed",
      "datasource": {
        "type": "datasource",
        "uid": "-- Dashboard --"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "datasource",
            "uid": "-- Dashboard --"
          },
          "refId": "A",
          "panelId": 4,
          "withTransforms": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "sum"
          ],
          "fields": "/^lines$/",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "value",
        "wideLayout": true
      },
      "transformations": [
        {
          "id": "calculateField",
          "options": {
            "mode": "binary",
            "alias": "lines",
            "binary": {
              "left": {
                "matcher": {
                  "id": "byName",
                  "options": "additions"
                }
              },
              "operator": "+",
              "right": {
                "matcher": {
                  "id": "byName",
                  "options": "deletions"
                }
              }
            },
            "replaceFields": true
          }
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Merges per day",
      "datasource": {
        "type": "datasource",
        "uid": "-- Dashboard --"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "datasource",
            "uid": "-- Dashboard --"
          },
          "refId": "A",
          "panelId": 4,
          "withTransforms": false
        }
      ],
      "transformations": [
        {
          "id": "formatTime",
          "options": {
            "timeField": "merged_at",
            "outputFormat": "YYYY-MM-DD",
            "useTimezone": true
          }
        },
        {
          "id": "groupBy",
          "options": {
            "fields": {
              "merged_at": {
                "aggregations": [],
                "operation": "groupby"
              },
              "number": {
                "aggregations": [
                  "count"
                ],
                "operation": "aggregate"
              }
            }
          }
        },
        {
          "id": "convertFieldType",
          "options": {
            "conversions": [
              {
                "targetField": "merged_at",
                "destinationType": "time",
                "dateFormat": "YYYY-MM-DD"
              }
            ],
            "fields": {}
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "merged_at"
              }
            ]
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "displayName": "Merged",
          "unit": "none",
          "decimals": 0,
          "min": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "green"
          },
          "custom": {
            "drawStyle": "bars",
            "barAlignment": 0,
            "barWidthFactor": 0.8,
            "fillOpacity": 70,
            "lineWidth": 1,
            "showPoints": "never",
            "axisSoftMin": 0
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": false
        },
        "tooltip": {
          "mode": "single"
        }
      }
    },
    {
      "id": 4,
      "type": "table",
      "title": "Merged pull requests",
      "datasource": {
        "type": "grafana-github-datasource",
        "uid": "github"
      },
      "gridPos": {
        "h": 20,
        "w": 24,
        "x": 0,
        "y": 12
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-github-datasource",
            "uid": "github"
          },
          "refId": "A",
          "queryType": "Pull_Requests",
          "owner": "mortennordbye",
          "repository": "$repository",
          "options": {
            "query": "is:merged",
            "timeField": 2
          }
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "includeByName": {
              "number": true,
              "title": true,
              "author_login": true,
              "merged_at": true,
              "open_time": true,
              "additions": true,
              "deletions": true,
              "url": true
            },
            "indexByName": {
              "merged_at": 0,
              "number": 1,
              "title": 2,
              "author_login": 3,
              "open_time": 4,
              "additions": 5,
              "deletions": 6,
              "url": 7
            },
            "renameByName": {
              "merged_at": "Merged",
              "number": "PR",
              "title": "Title",
              "author_login": "Author",
              "open_time": "Open for",
              "additions": "Added",
              "deletions": "Removed"
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "Merged",
                "desc": true
              }
            ]
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Merged"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 150
              },
              {
                "id": "unit",
                "value": "time:YYYY-MM-DD HH:mm"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "PR"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 70
              },
              {
                "id": "custom.align",
                "value": "left"
              },
              {
                "id": "unit",
                "value": "none"
              },
              {
                "id": "decimals",
                "value": 0
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Title"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Open PR",
                    "url": "${__data.fields.url}",
                    "targetBlank": true
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Author"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 160
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "special",
                    "options": {
                      "match": "empty",
                      "result": {
                        "text": "bot",
                        "color": "text",
                        "index": 0
                      }
                    }
                  },
                  {
                    "type": "special",
                    "options": {
                      "match": "null",
                      "result": {
                        "text": "bot",
                        "color": "text",
                        "index": 1
                      }
                    }
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Open for"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 110
              },
              {
                "id": "unit",
                "value": "s"
              },
              {
                "id": "decimals",
                "value": 0
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Added"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 90
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Removed"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 90
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "url"
            },
            "properties": [
              {
                "id": "custom.hidden",
                "value": true
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      }
    }
  ]
}
