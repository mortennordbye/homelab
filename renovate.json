{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":rebaseStalePrs",
    ":semanticCommits"
  ],
  "timezone": "Europe/Oslo",
  "schedule": [
    "after 10pm every weekday",
    "before 5am every weekday",
    "every weekend"
  ],
  "labels": ["dependencies"],
  "automergeStrategy": "squash",
  "osvVulnerabilityAlerts": true,
  "dependencyDashboardOSVVulnerabilitySummary": "unresolved",
  "vulnerabilityAlerts": {
    "description": "Security fixes bypass group stability windows and the nightly schedule. groupName null keeps each CVE on its own branch, so one stuck fix can't hold up the rest.",
    "enabled": true,
    "automerge": true,
    "schedule": ["at any time"],
    "minimumReleaseAge": "3 days",
    "groupName": null,
    "addLabels": ["security", "automerge"]
  },
  "kubernetes": {
    "managerFilePatterns": ["/k8s/.*\\.ya?ml$/"]
  },
  "helm-values": {
    "managerFilePatterns": ["/k8s/.*/values\\.ya?ml$/"]
  },
  "kustomize": {
    "managerFilePatterns": ["/k8s/.*/kustomization\\.ya?ml$/"]
  },
  "terraform": {
    "managerFilePatterns": ["/terraform/.*\\.tf$/"]
  },
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/\\.ya?ml$/", "/\\.tfvars\\.example$/"],
      "matchStrings": [
        "(?<currentValue>[\\w+\\.\\-]*)['\",;]*\\s*#\\s?renovate: (?<datasource>\\S+)=(?<depName>\\S+)\\s?(registry=(?<registryUrl>\\S+))?\\s?(versioning=(?<versioning>\\S+))?"
      ]
    }
  ],
  "packageRules": [
    {
      "description": "GitHub Actions: group all minor/patch/digest, automerge",
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["minor", "patch", "digest"],
      "groupName": "GitHub Actions",
      "groupSlug": "github-actions",
      "automerge": true,
      "platformAutomerge": true,
      "addLabels": ["github-actions"]
    },
    {
      "description": "Helm Networking: traefik, cilium, cert-manager, external-dns, traefik-crds",
      "matchManagers": ["kustomize"],
      "matchPackageNames": ["traefik", "traefik-crds", "cilium", "cert-manager", "external-dns"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "Helm Networking",
      "groupSlug": "helm-networking",
      "automerge": true,
      "minimumReleaseAge": "7 days",
      "addLabels": ["helm", "networking"]
    },
    {
      "description": "Helm Platform: argo-cd, argo-rollouts, kargo, reloader, keda, metrics-server, external-secrets, csi drivers",
      "matchManagers": ["kustomize"],
      "matchPackageNames": [
        "argo-cd",
        "argo-rollouts",
        "kargo",
        "ghcr.io/akuity/kargo-charts/kargo",
        "reloader",
        "keda",
        "keda-add-ons-http",
        "metrics-server",
        "external-secrets",
        "proxmox-csi-plugin",
        "csi-driver-nfs"
      ],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "Helm Platform",
      "groupSlug": "helm-platform",
      "automerge": true,
      "minimumReleaseAge": "7 days",
      "addLabels": ["helm", "platform"]
    },
    {
      "description": "Helm Monitoring: kube-prometheus-stack, loki, tempo, alloy",
      "matchManagers": ["kustomize"],
      "matchPackageNames": ["kube-prometheus-stack", "loki", "tempo", "alloy"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "Helm Monitoring",
      "groupSlug": "helm-monitoring",
      "automerge": true,
      "minimumReleaseAge": "7 days",
      "addLabels": ["helm", "monitoring"]
    },
    {
      "description": "Helm Security: authentik, falco — longer soak than the other groups, since a bad authentik locks us out of everything behind it",
      "matchManagers": ["kustomize"],
      "matchPackageNames": ["authentik", "falco", "falco-falcosidekick"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "Helm Security",
      "groupSlug": "helm-security",
      "automerge": true,
      "minimumReleaseAge": "14 days",
      "addLabels": ["helm", "security"]
    },
    {
      "description": "Dockerfile base images: group and automerge minor/patch",
      "matchManagers": ["dockerfile"],
      "matchUpdateTypes": ["minor", "patch", "digest"],
      "groupName": "Dockerfile Base Images",
      "groupSlug": "docker-base-images",
      "automerge": true,
      "platformAutomerge": true,
      "addLabels": ["docker"]
    },
    {
      "description": "K8s Docker - arr-stack segment",
      "matchDatasources": ["docker"],
      "matchFileNames": ["k8s/talos/apps/arr-stack/**"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "Arr Stack",
      "groupSlug": "arr-stack",
      "automerge": true,
      "minimumReleaseAge": "14 days",
      "addLabels": ["arr-stack"]
    },
    {
      "description": "K8s Docker - plex-media-stack segment",
      "matchDatasources": ["docker"],
      "matchFileNames": ["k8s/talos/apps/plex-media-stack/**"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "Plex Media Stack",
      "groupSlug": "plex-stack",
      "automerge": true,
      "minimumReleaseAge": "14 days",
      "addLabels": ["plex"]
    },
    {
      "description": "K8s Docker - all other apps, grouped",
      "matchDatasources": ["docker"],
      "matchFileNames": ["k8s/talos/apps/**"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "K8s Apps",
      "groupSlug": "k8s-apps",
      "automerge": true,
      "minimumReleaseAge": "14 days",
      "addLabels": ["k8s-apps"]
    },
    {
      "description": "K8s Docker - infra images",
      "matchDatasources": ["docker"],
      "matchFileNames": ["k8s/talos/infra/**"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "K8s Infra Images",
      "groupSlug": "k8s-infra",
      "automerge": true,
      "minimumReleaseAge": "7 days",
      "addLabels": ["k8s-infra"]
    },
    {
      "description": "npm - portfolio project",
      "matchManagers": ["npm"],
      "matchFileNames": ["portfolio/**"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "npm Portfolio",
      "groupSlug": "npm-portfolio",
      "automerge": true,
      "minimumReleaseAge": "3 days",
      "addLabels": ["npm", "portfolio"]
    },
    {
      "description": "npm - blog theme",
      "matchManagers": ["npm"],
      "matchFileNames": ["blog/**"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "npm Blog",
      "groupSlug": "npm-blog",
      "automerge": true,
      "minimumReleaseAge": "3 days",
      "addLabels": ["npm", "blog"]
    },
    {
      "description": "Python - Jarvis AI project",
      "matchManagers": ["pip_requirements"],
      "matchFileNames": ["ai/**"],
      "groupName": "Jarvis AI",
      "groupSlug": "jarvis-ai",
      "automerge": true,
      "minimumReleaseAge": "3 days",
      "addLabels": ["python", "ai"]
    },
    {
      "description": "GitHub Actions major: group all major bumps for manual review",
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["major"],
      "groupName": "GitHub Actions (major)",
      "groupSlug": "github-actions-major",
      "automerge": false,
      "addLabels": ["github-actions", "major-update"]
    },
    {
      "description": "Helm major: group all major chart bumps for manual review",
      "matchManagers": ["kustomize"],
      "matchUpdateTypes": ["major"],
      "groupName": "Helm Major Updates",
      "groupSlug": "helm-major",
      "automerge": false,
      "addLabels": ["helm", "major-update"]
    },
    {
      "description": "npm Portfolio major updates",
      "matchManagers": ["npm"],
      "matchFileNames": ["portfolio/**"],
      "matchUpdateTypes": ["major"],
      "groupName": "npm Portfolio (major)",
      "groupSlug": "npm-portfolio-major",
      "automerge": false,
      "addLabels": ["npm", "portfolio", "major-update"]
    },
    {
      "description": "npm Blog major updates",
      "matchManagers": ["npm"],
      "matchFileNames": ["blog/**"],
      "matchUpdateTypes": ["major"],
      "groupName": "npm Blog (major)",
      "groupSlug": "npm-blog-major",
      "automerge": false,
      "addLabels": ["npm", "blog", "major-update"]
    },
    {
      "description": "Terraform providers: group and automerge non-major. Nothing applies Terraform automatically, so a merged bump is a code change only — the plan still runs by hand.",
      "matchManagers": ["terraform"],
      "groupName": "Terraform",
      "groupSlug": "terraform",
      "automerge": true,
      "minimumReleaseAge": "7 days",
      "addLabels": ["terraform"]
    },
    {
      "description": "Terraform helm_release charts duplicate the kustomize-managed infra charts. If these drift apart, a later terraform apply upgrades Cilium or ArgoCD out from under ArgoCD — bump both sides together, by hand.",
      "matchManagers": ["terraform"],
      "matchPackageNames": ["argo-cd", "cilium"],
      "automerge": false,
      "addLabels": ["terraform", "bootstrap"]
    },
    {
      "description": "Talos and Kubernetes node versions. Tracked so they stop being invisible, never automerged — a fleet upgrade is a maintenance window with an etcd snapshot, not a merge.",
      "matchManagers": ["custom.regex"],
      "matchPackageNames": ["siderolabs/talos", "kubernetes/kubernetes"],
      "groupName": "Cluster (Talos / Kubernetes)",
      "groupSlug": "cluster-talos-k8s",
      "automerge": false,
      "minimumReleaseAge": "30 days",
      "addLabels": ["cluster", "major-update"]
    },
    {
      "description": "Major updates always require manual review",
      "matchUpdateTypes": ["major"],
      "automerge": false,
      "addLabels": ["major-update"]
    },
    {
      "description": "Disable: Kargo owns these tags. The Warehouse writes newTag in kustomization.yaml via kustomize-set-image, and the inline tag in deployment.yaml is dead weight the overlay overrides. Renovate bumping either one just fights the promotion pipeline.",
      "matchDatasources": ["docker"],
      "matchPackageNames": [
        "ghcr.io/mortennordbye/homelab/portfolio",
        "ghcr.io/mortennordbye/homelab/blog",
        "ghcr.io/mortennordbye/headroom",
        "ghcr.io/mortennordbye/verksted",
        "ghcr.io/mortennordbye/reelsmith-gateway",
        "ghcr.io/mortennordbye/logeverylift"
      ],
      "enabled": false
    },
    {
      "description": "Disable: huntarr.yaml is commented out of the arr-stack kustomization and ghcr.io/plexguide/huntarr no longer resolves. Left in place rather than deleted; see BACKLOG.md.",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["ghcr.io/plexguide/huntarr"],
      "enabled": false
    },
    {
      "description": "Pin: the workout namespace is a scaled-to-zero rollback snapshot from the logeverylift cutover, not a running database. Upgrading it to 18 would rewrite the data into a format the stack it is a rollback for cannot read. Stays on 16 until the app is deleted — see BACKLOG.md.",
      "matchDatasources": ["docker"],
      "matchFileNames": ["k8s/talos/apps/workout/**"],
      "matchPackageNames": ["postgres"],
      "allowedVersions": "<17",
      "addLabels": ["postgres", "pinned"]
    },
    {
      "description": "Disable: qbittorrent managed separately",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["ghcr.io/linuxserver/qbittorrent"],
      "enabled": false
    },
    {
      "description": "Disable: texlive pinned intentionally",
      "matchDepNames": ["texlive/texlive"],
      "enabled": false
    }
  ]
}
