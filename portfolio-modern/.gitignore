# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# LaTeX build artifacts and locally-generated CV PDFs.
# Generated by `make cv` for local preview — not committed. In production
# the multi-stage Dockerfile rebuilds them on every image build, so they
# never need to live in git.
latex/CV_2025/output/
public/resume.pdf
public/cv.pdf

# Generated LaTeX sources — src/content/*.ts is the single source of truth.
# Regenerated by `make cv-gen` (which scripts/build-cv.ts overwrites). Hand
# edits here are clobbered, so we don't track them.
latex/CV_2025/cv.tex
latex/CV_2025/resume.tex
latex/CV_2025/cv/*.tex
latex/CV_2025/resume/*.tex

# xelatex/pdflatex artifacts at the latex root, regardless of which tool
# produced them (the Makefile target writes to output/, but IDE
# integrations may compile in-place).
latex/CV_2025/*.aux
latex/CV_2025/*.log
latex/CV_2025/*.out
latex/CV_2025/*.toc
latex/CV_2025/*.synctex.gz
latex/CV_2025/*.fls
latex/CV_2025/*.fdb_latexmk
latex/CV_2025/*.pdf
latex/CV_2025/missfont.log
