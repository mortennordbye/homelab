---
import type { StarlightRouteData } from "@astrojs/starlight/route-data";
type SidebarEntry = StarlightRouteData["sidebar"][number];
import SidebarRestorePoint from "@astrojs/starlight/components/SidebarRestorePoint.astro";
import { groupMarks, pageMarks } from "../logos";
import Mark from "./Mark.astro";

interface Props { sublist: SidebarEntry[]; nested?: boolean; group?: string }
const { sublist, nested, group } = Astro.props;

const hasCurrent = (e: SidebarEntry): boolean => (e.type === "link" ? e.isCurrent : e.entries.some(hasCurrent));
---
<ul class:list={["eden-nav", { "top-level": !nested }]}>
  {sublist.map((entry) => (
    <li>
      {entry.type === "link" ? (
        <a href={entry.href} aria-current={entry.isCurrent ? "page" : undefined} {...entry.attrs}>
          <Mark mark={pageMarks[entry.href] ?? { icon: "page", dim: true }} />
          {/* A folder's README carries the folder name, which the group row already shows. */}
          <span>{entry.label === group ? "Overview" : entry.label}</span>
        </a>
      ) : nested ? (
        <details open={hasCurrent(entry) || !entry.collapsed}>
          <summary>
            <Mark mark={groupMarks[entry.label]} />
            <span>{entry.label}</span>
            <span class="chev" aria-hidden="true">&rsaquo;</span>
          </summary>
          <SidebarRestorePoint />
          <Astro.self sublist={entry.entries} nested group={entry.label} />
        </details>
      ) : (
        <div class="eden-nav__group">
          <span class="eden-nav__label">{entry.label}</span>
          <Astro.self sublist={entry.entries} nested />
        </div>
      )}
    </li>
  ))}
</ul>
