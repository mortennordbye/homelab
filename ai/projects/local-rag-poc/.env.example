# Copy to .env and adjust if your LM Studio setup differs from the defaults.
# .env is gitignored — never commit it.

# LM Studio endpoint.
#   - Native venv on the host: http://localhost:1234/v1
#   - Inside Docker (default in the Makefile): http://host.docker.internal:1234/v1
LM_STUDIO_BASE_URL=http://localhost:1234/v1

# LM Studio ignores the API key but the OpenAI SDK requires *some* value.
LM_STUDIO_API_KEY=lm-studio

# Model identifiers as reported by LM Studio's Developer tab.
# Confirm with:   curl http://localhost:1234/v1/models | jq '.data[].id'
#
# Recommended defaults (see README "LM Studio models" section for alternatives
# like gpt-oss-20b, Gemma 3 12B, Qwen3 Coder 30B):
#   - Embeddings: nomic-ai/nomic-embed-text-v1.5-GGUF              (Q4_K_M, ~90 MB)
#   - Chat:       lmstudio-community/Meta-Llama-3.1-8B-Instruct-GGUF (Q4_K_M, ~4.9 GB)
EMBED_MODEL=text-embedding-nomic-embed-text-v1.5
CHAT_MODEL=llama-3.1-8b-instruct
