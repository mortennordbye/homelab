#!/usr/bin/env bash
# Copies a Secrets Manager value into the Bitwarden vault as a login in the Homelab folder.
# The human runs this; the agent never unlocks the vault. Only the new item's name and id are printed.
#   vault-add <item-name> <username> <bws-secret-id> [uri]
set -euo pipefail

[[ $# -ge 3 ]] || { echo "usage: $0 <item-name> <username> <bws-secret-id> [uri]" >&2; exit 2; }
name=$1 username=$2 secret_id=$3 uri=${4:-}
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

session="${BW_SESSION:-}"
case "$(bw status | jq -r .status)" in
  unauthenticated) echo "run 'bw login' first" >&2; exit 1 ;;
  locked) session=$(bw unlock --raw) ;;
esac
bw sync --session "$session" >/dev/null

folder=$(bw list folders --search Homelab --session "$session" | jq -r 'map(select(.name == "Homelab")) | .[0].id // empty')
[[ -n "$folder" ]] || { echo "no vault folder named Homelab" >&2; exit 1; }

password=$(BWS_ACCESS_TOKEN=$("$here/bws-token") bws secret get "$secret_id" --output json | jq -r .value)

jq -n --arg name "$name" --arg user "$username" --arg pass "$password" --arg uri "$uri" --arg folder "$folder" '{
  type: 1, name: $name, folderId: $folder, notes: null, favorite: false,
  login: {username: $user, password: $pass, uris: (if $uri == "" then [] else [{uri: $uri, match: null}] end)}
}' | bw encode | bw create item --session "$session" | jq -r '"created " + .name + " (" + .id + ")"'
