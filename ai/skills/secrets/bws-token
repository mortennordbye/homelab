#!/usr/bin/env bash
# Prints the agent Secrets Manager access token for this machine.
#   BWS_ACCESS_TOKEN=$(bws-token) bws secret ...
#   bws-token setup    copy the token from the Bitwarden vault into this machine's store (once per machine)
#
# The vault item is the source of truth; the local copy is a cache. See docs/platform/secrets/README.md.
set -euo pipefail

ITEM="bws agent token"
SERVICE="bws-agent"
FILE="${XDG_CONFIG_HOME:-$HOME/.config}/bws/token"

read_token() {
  if [[ -n "${BWS_ACCESS_TOKEN:-}" ]]; then
    printf '%s' "$BWS_ACCESS_TOKEN"
  elif [[ "$(uname)" == Darwin ]]; then
    security find-generic-password -s "$SERVICE" -w 2>/dev/null
  elif [[ -r "$FILE" ]]; then
    cat "$FILE"
  else
    return 1
  fi
}

store_token() {
  if [[ "$(uname)" == Darwin ]]; then
    security add-generic-password -U -s "$SERVICE" -a "$USER" -w "$1"
  else
    mkdir -p "$(dirname "$FILE")"
    (umask 077 && printf '%s' "$1" > "$FILE")
  fi
}

setup() {
  for cmd in bw bws jq; do
    command -v "$cmd" >/dev/null || { echo "missing $cmd" >&2; exit 1; }
  done

  local session="${BW_SESSION:-}"
  case "$(bw status | jq -r .status)" in
    unauthenticated) echo "run 'bw login' first" >&2; exit 1 ;;
    locked) session=$(bw unlock --raw) ;;
  esac
  bw sync --session "$session" >/dev/null

  local token
  token=$(bw get password "$ITEM" --session "$session")
  store_token "$token"

  BWS_ACCESS_TOKEN="$token" bws project list --output json \
    | jq -r '"token works, projects: " + (map(.name) | join(", "))'

  # Commands on PATH, and the skill in every agent's global skill folder, so other repos get both.
  local here bin="$HOME/.local/bin"
  here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
  mkdir -p "$bin"
  ln -sfn "$here/bws-token" "$bin/bws-token"
  ln -sfn "$here/vault-add" "$bin/vault-add"
  for agent in "$HOME/.claude" "$HOME/.codex" "$HOME/.agents"; do
    if [[ -d "$agent" && ! -e "$agent/skills/secrets" ]]; then
      mkdir -p "$agent/skills"
      ln -s "$here" "$agent/skills/secrets"
      echo "linked $agent/skills/secrets"
    fi
  done
}

case "${1:-}" in
  setup) setup ;;
  "") read_token || { echo "no bws token on this machine; run: $0 setup" >&2; exit 1; } ;;
  *) echo "usage: $0 [setup]" >&2; exit 2 ;;
esac
