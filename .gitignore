# ──────────────────────────────────────────────────────────────
# Secrets & credentials
# ──────────────────────────────────────────────────────────────
.env
**/*.env
*.key
*.pem

# Talos & Kubernetes credentials
talosconfig
kubeconfig
machine-secrets.yaml
controlplane.yaml
worker.yaml

# Ansible vault
vault_password.txt
.ansible

# ──────────────────────────────────────────────────────────────
# Terraform
# ──────────────────────────────────────────────────────────────
*.tfstate
*.tfstate.*
*.tfvars
*.tfvars.json
*.auto.tfvars
*.tfplan
.terraform/
.terraform.lock.hcl
.terraform.tfstate.lock.info
backend.conf
backend.hcl
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Kustomize helm chart cache — regenerated locally by `kustomize build --enable-helm`;
# ArgoCD pulls the chart fresh on sync.
k8s/**/charts/

# ──────────────────────────────────────────────────────────────
# Build output
# ──────────────────────────────────────────────────────────────
# Hugo (blog) — rendered in CI, never committed
blog/public/
blog/resources/
.hugo_build.lock
# Root-level Node tooling must never be committed (apps keep their own node_modules)
/node_modules/
/package.json
/package-lock.json

# ──────────────────────────────────────────────────────────────
# AI — never commit local model weights or runtime caches
# ──────────────────────────────────────────────────────────────
ai/local-llm/**/*.gguf
ai/local-llm/**/*.bin
ai/local-llm/**/*.safetensors
ai/local-llm/**/*.pt
ai/local-llm/**/*.onnx
ai/**/.venv/
ai/**/__pycache__/
# Jarvis runtime artefacts (state DB, voice clone samples)
ai/projects/jarvis
ai/projects/jarvis/.state/
ai/projects/jarvis/voices/*.wav
ai/projects/jarvis/voices/*.wav.txt
ai/prompts/erlendgpt

# ──────────────────────────────────────────────────────────────
# Local-only files (deliberately kept out of the public repo)
# ──────────────────────────────────────────────────────────────
blog/README.md
blog/TEXT-STYLE.md
blog/IMAGE-STYLE.md
blog/LINKEDIN-STYLE.md
blog/REDDIT-STYLE.md
/lawless-waf-overview.png
qbittorrent-vpn/
# Local working notes — handovers, diagnoses, plans (kept out of the public repo)
/.notes/
.screenshots/
.playwright-mcp/
.claude/settings.local.json

# ──────────────────────────────────────────────────────────────
# Logs, temp files, archives
# ──────────────────────────────────────────────────────────────
logs/
*.log
crash.log
crash.*.log
docker-compose.override.yml
*.backup
*.bak
*.tmp
tmp/
*.zip
*.tar.gz
*.tgz

# ──────────────────────────────────────────────────────────────
# OS & editor
# ──────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.*.swp
*.swo
*.swnc
*~
.vscode/
.idea/
