# Secrets & env files
.env
**/*.env
*.key
*.pem

# OS/editor files
.DS_Store
Thumbs.db
.*.swp
*~
*.swo
*.swnc
.vscode/
.idea/

# Claude Code per-machine settings (agent definitions under .claude/agents/ stay tracked)
.claude/settings.local.json

# Logs
logs/
*.log
crash.log
crash.*.log
docker-compose.override.yml

# Terraform
*.tfstate
*.tfstate.*
*.tfvars
*.tfvars.json
*.auto.tfvars
*.tfplan
.terraform/
.terraform.lock.hcl
.terraform.tfstate.lock.info
backend.conf
backend.hcl
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Ansible
vault_passaword.txt
.ansible

# Talos & Kubernetes (sensitive credentials)
talosconfig
kubeconfig
machine-secrets.yaml
controlplane.yaml
worker.yaml

# Backup & Temporary Files
*.backup
*.bak
*.tmp
tmp/

# Archives
*.zip
*.tar.gz
*.tgz

# Application folders
#arr-stack/
qbittorrent-vpn/
kubernetes/
blog/README.md

# Local dev / tooling artifacts (must never be committed at repo root)
.screenshots/
.playwright-mcp/
/node_modules/
/package.json
/package-lock.json

# Kustomize helm chart cache — regenerated locally by `kustomize build --enable-helm`,
# ArgoCD pulls the chart fresh on sync.
k8s/**/charts/

# AI — never commit local LLM weights or runtime caches
ai/local-llm/**/*.gguf
ai/local-llm/**/*.bin
ai/local-llm/**/*.safetensors
ai/local-llm/**/*.pt
ai/local-llm/**/*.onnx
ai/**/.venv/
ai/**/__pycache__/

# AI — Jarvis runtime artefacts (state DB, voice clone samples)
ai/projects/jarvis
ai/projects/jarvis/.state/
ai/projects/jarvis/voices/*.wav
ai/projects/jarvis/voices/*.wav.txt
