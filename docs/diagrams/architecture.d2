# Homelab — Genesis Kubernetes Architecture (source of truth)
# Render to SVG/PNG with the containerized d2:  make diagram
# Icons are pulled from public icon repos at render time and inlined as data
# URIs, so the committed image is self-contained:
#   - most services: homarr-labs/dashboard-icons (colored, raw.githubusercontent)
#   - falco:         cncf/artwork
# raw.githubusercontent.com is reachable from GitHub Actions runners (unlike
# cdn.simpleicons.org, which 403s datacenter IPs).

direction: down

net: Internet {
  shape: cloud
}

gh: GitHub {
  shape: image
  icon: https://raw.githubusercontent.com/homarr-labs/dashboard-icons/main/svg/github.svg
}

argocd: ArgoCD\n(GitOps) {
  shape: image
  icon: https://raw.githubusercontent.com/homarr-labs/dashboard-icons/main/svg/argo-cd.svg
}

cluster: Genesis · Talos Kubernetes {
  edge: Ingress & Edge {
    traefik: Traefik {
      shape: image
      icon: https://raw.githubusercontent.com/homarr-labs/dashboard-icons/main/svg/traefik.svg
    }
    cert: cert-manager {
      shape: image
      icon: https://raw.githubusercontent.com/homarr-labs/dashboard-icons/main/svg/cert-manager.svg
    }
  }

  netf: Networking {
    cilium: Cilium {
      shape: image
      icon: https://raw.githubusercontent.com/homarr-labs/dashboard-icons/main/svg/cilium.svg
    }
  }

  sec: Security {
    falco: Falco {
      shape: image
      icon: https://raw.githubusercontent.com/cncf/artwork/main/projects/falco/icon/color/falco-icon-color.svg
    }
    authentik: Authentik {
      shape: image
      icon: https://raw.githubusercontent.com/homarr-labs/dashboard-icons/main/svg/authentik.svg
    }
    eso: External\nSecrets
  }

  obs: Observability {
    prometheus: Prometheus {
      shape: image
      icon: https://raw.githubusercontent.com/homarr-labs/dashboard-icons/main/svg/prometheus.svg
    }
    grafana: Grafana {
      shape: image
      icon: https://raw.githubusercontent.com/homarr-labs/dashboard-icons/main/svg/grafana.svg
    }
    loki: Loki {
      shape: image
      icon: https://raw.githubusercontent.com/homarr-labs/dashboard-icons/main/svg/loki.svg
    }
    tempo: Tempo {
      shape: image
      icon: https://raw.githubusercontent.com/homarr-labs/dashboard-icons/main/svg/tempo.svg
    }
  }

  plat: Platform {
    reloader: Reloader
    metrics: metrics-server {
      shape: image
      icon: https://raw.githubusercontent.com/homarr-labs/dashboard-icons/main/svg/kubernetes.svg
    }
  }

  apps: Applications {
    portfolio: Portfolio {
      shape: image
      icon: https://raw.githubusercontent.com/homarr-labs/dashboard-icons/main/svg/nginx.svg
    }
    blog: Blog {
      shape: image
      icon: https://raw.githubusercontent.com/homarr-labs/dashboard-icons/main/svg/hugo.svg
    }
    workout: Workout {
      shape: image
      icon: https://raw.githubusercontent.com/homarr-labs/dashboard-icons/main/svg/postgresql.svg
    }
  }
}

store: Storage {
  csi: Proxmox CSI {
    shape: image
    icon: https://raw.githubusercontent.com/homarr-labs/dashboard-icons/main/svg/proxmox.svg
  }
  nfs: Synology NFS {
    shape: image
    icon: https://raw.githubusercontent.com/homarr-labs/dashboard-icons/main/svg/synology.svg
  }
}

base: Proxmox VE · Talos Linux {
  proxmox: Proxmox VE {
    shape: image
    icon: https://raw.githubusercontent.com/homarr-labs/dashboard-icons/main/svg/proxmox.svg
  }
  talos: Talos Linux {
    shape: image
    icon: https://raw.githubusercontent.com/homarr-labs/dashboard-icons/main/svg/talos.svg
  }
}

# Flow: entry point → all the way down to hardware
net -> cluster.edge.traefik: HTTPS
gh -> argocd: git push
argocd -> cluster: reconciles
cluster.edge.traefik -> cluster.apps: routes
cluster -> store: persistent volumes
cluster -> base: runs on
