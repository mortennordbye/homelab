# Homelab — network & service flow (who talks to whom)
# Source of truth. Render:  make diagram   (layout: elk)
# Icons pulled from public repos at render time and inlined (self-contained):
#   ${di} homarr-labs/dashboard-icons   ${sh} selfhst/icons   plus cncf/artwork (falco)

vars: {
  di: https://raw.githubusercontent.com/homarr-labs/dashboard-icons/main/svg
  sh: https://raw.githubusercontent.com/selfhst/icons/main/svg
  falcoicon: https://raw.githubusercontent.com/cncf/artwork/main/projects/falco/icon/color/falco-icon-color.svg
}

direction: down

title: Homelab · Network & Service Flow {
  shape: text
  near: top-center
  style: {font-size: 60; bold: true; font-color: "#0f172a"}
}

classes: {
  layer: {style: {stroke-width: 2; border-radius: 16; shadow: true; font-size: 19; bold: true}}
  ext: {style: {stroke-width: 2; border-radius: 10; font-size: 14; bold: true; fill: "#f8fafc"; stroke: "#94a3b8"; font-color: "#334155"}}
}

# ───────────── External ─────────────
internet: Internet {shape: cloud; style: {fill: "#f1f5f9"; stroke: "#64748b"; bold: true}}
github: GitHub {shape: image; icon: ${di}/github.svg}
ghcr: "GHCR\n(container registry)" {shape: image; icon: ${di}/github.svg}
bitwarden: Bitwarden {shape: image; icon: ${di}/bitwarden.svg}
cloudflare: Cloudflare DNS {shape: image; icon: ${di}/cloudflare.svg}
letsencrypt: Let's Encrypt {shape: image; icon: ${di}/lets-encrypt.svg}
discord: Discord {shape: image; icon: ${di}/discord.svg}
pia: PIA VPN {shape: image; icon: ${di}/private-internet-access.svg}

# ───────────── Network edge ─────────────
edge: Network Edge {
  class: layer
  style.font-size: 34
  style: {fill: "#e0f2fe"; stroke: "#0284c7"; font-color: "#0c4a6e"}
  modem: "Telia Modem\n(bridge · translation layer)"
  gw: UniFi Gateway {shape: image; icon: ${di}/unifi.svg}
  sw: UniFi Switch {shape: image; icon: ${di}/unifi.svg}
  ap: UniFi U6+ AP {shape: image; icon: ${di}/unifi.svg}
}

# ───────────── Ingress & cluster networking ─────────────
net: Ingress & Cluster Networking {
  class: layer
  style.font-size: 34
  style: {fill: "#cffafe"; stroke: "#0891b2"; font-color: "#155e75"}
  traefik: Traefik {shape: image; icon: ${di}/traefik.svg}
  cert: cert-manager {shape: image; icon: ${di}/cert-manager.svg}
  externaldns: external-dns {shape: image; icon: ${di}/cloudflare.svg}
  coredns: CoreDNS {shape: image; icon: ${di}/coredns.svg}
  cilium: Cilium {shape: image; icon: ${di}/cilium.svg}
  interceptor: "KEDA HTTP Interceptor\n(wake-from-zero)" {shape: image; icon: ${di}/keda.svg}
}

# ───────────── GitOps & config ─────────────
ops: GitOps & Config {
  class: layer
  style.font-size: 34
  style: {fill: "#eef2ff"; stroke: "#4f46e5"; font-color: "#312e81"}
  argocd: ArgoCD {shape: image; icon: ${di}/argo-cd.svg}
  kargo: "Kargo\n(promotion)"
  eso: External Secrets
  reloader: Reloader
  keda: KEDA {shape: image; icon: ${di}/keda.svg}
  rollouts: "Argo Rollouts" {shape: image; icon: ${di}/argo-cd.svg}
}

# ───────────── Public sites ─────────────
sites: Public Sites {
  class: layer
  style.font-size: 34
  style: {fill: "#f5f3ff"; stroke: "#7c3aed"; font-color: "#5b21b6"}
  portfolio: Portfolio {shape: image; icon: ${di}/nginx.svg}
  portfolio_stage: "Portfolio (stage)" {shape: image; icon: ${di}/nginx.svg; style.opacity: 0.7}
  blog: Blog {shape: image; icon: ${di}/hugo.svg}
  blog_stage: "Blog (stage)" {shape: image; icon: ${di}/hugo.svg; style.opacity: 0.7}
  workout: Workout {shape: image; icon: ${di}/nextjs.svg}
  postgres: PostgreSQL {shape: image; icon: ${di}/postgresql.svg}
  homepage: Homepage {shape: image; icon: ${sh}/homepage.svg}
  abs: Audiobookshelf {shape: image; icon: ${di}/audiobookshelf.svg}
  ittools: IT-Tools {shape: image; icon: ${di}/it-tools.svg}
  omnitools: Omni-Tools
  headroom: "Headroom\n(personal finance app)"
  mealie: Mealie {shape: image; icon: ${di}/mealie.svg}
  logeverylift: "LogEveryLift (local)" {shape: image; icon: ${di}/nextjs.svg; style.opacity: 0.7}
  verksted: "Verksted\n(workshop)"
  bigd: "bigd.no" {shape: image; icon: ${di}/nginx.svg}
}

# ───────────── Media stack ─────────────
media: Media Stack {
  class: layer
  style.font-size: 34
  style: {fill: "#fdf2f8"; stroke: "#db2777"; font-color: "#9d174d"}
  seerr: Seerr {shape: image; icon: ${di}/jellyseerr.svg}
  plex: Plex {shape: image; icon: ${di}/plex.svg}
  tautulli: Tautulli {shape: image; icon: ${di}/tautulli.svg}
  prowlarr: Prowlarr {shape: image; icon: ${di}/prowlarr.svg}
  sonarr: Sonarr {shape: image; icon: ${di}/sonarr.svg}
  radarr: Radarr {shape: image; icon: ${di}/radarr.svg}
  bazarr: Bazarr {shape: image; icon: ${di}/bazarr.svg}
  flaresolverr: FlareSolverr {shape: image; icon: ${di}/flaresolverr.svg}
  qbit: qBittorrent {shape: image; icon: ${di}/qbittorrent.svg}
  gluetun: Gluetun VPN {shape: image; icon: ${di}/gluetun.svg}
}

# ───────────── AI / LLM ─────────────
ai: AI / LLM {
  class: layer
  style.font-size: 34
  style: {fill: "#fae8ff"; stroke: "#c026d3"; font-color: "#86198f"}
  ollama: Ollama {shape: image; icon: ${di}/ollama.svg}
  openwebui: Open WebUI {shape: image; icon: ${di}/open-webui.svg}
}

# ───────────── Observability ─────────────
obs: Observability {
  class: layer
  style.font-size: 34
  style: {fill: "#ccfbf1"; stroke: "#0d9488"; font-color: "#115e59"}
  prometheus: Prometheus {shape: image; icon: ${di}/prometheus.svg}
  alertmanager: Alertmanager {shape: image; icon: ${di}/alertmanager.svg}
  loki: Loki {shape: image; icon: ${di}/loki.svg}
  tempo: Tempo {shape: image; icon: ${di}/tempo.svg}
  grafana: Grafana {shape: image; icon: ${di}/grafana.svg}
  metrics: metrics-server {shape: image; icon: ${di}/kubernetes.svg}
  otel: "OTel Collector"
}

# ───────────── Security ─────────────
sec: Security {
  class: layer
  style.font-size: 34
  style: {fill: "#fee2e2"; stroke: "#dc2626"; font-color: "#7f1d1d"}
  falco: Falco {shape: image; icon: ${falcoicon}}
  sidekick: Falcosidekick
  authentik: Authentik {shape: image; icon: ${di}/authentik.svg}
}

# ───────────── Home automation ─────────────
home: Home Automation {
  class: layer
  style.font-size: 34
  style: {fill: "#dcfce7"; stroke: "#16a34a"; font-color: "#14532d"}
  ha: Home Assistant {shape: image; icon: ${di}/home-assistant.svg}
  adguard: AdGuard Home {shape: image; icon: ${di}/adguard-home.svg}
}

smart: Smart Home Devices {
  class: layer
  style.font-size: 34
  style: {fill: "#dcfce7"; stroke: "#16a34a"; font-color: "#14532d"}
  hue: Hue Bridge {shape: image; icon: ${sh}/philips-hue.svg}
  zigbee: Zigbee ZBT-2 {shape: image; icon: ${di}/zigbee2mqtt.svg}
  ble: BLE Proxy
  cam: UniFi Camera {shape: image; icon: ${di}/unifi.svg}
}

# ───────────── Storage ─────────────
store: Storage {
  class: layer
  style.font-size: 34
  style: {fill: "#fef3c7"; stroke: "#d97706"; font-color: "#78350f"}
  pcsi: Proxmox CSI {shape: image; icon: ${di}/proxmox.svg}
  nfscsi: NFS CSI {shape: image; icon: ${di}/synology.svg}
}

# ───────────── Physical hosts ─────────────
hw: Physical Hosts · Proxmox VE {
  class: layer
  style.font-size: 34
  style: {fill: "#f1f5f9"; stroke: "#475569"; font-color: "#1e293b"}
  hyper1: Hyper1 · M70q Gen 2 {shape: image; icon: ${di}/proxmox.svg}
  hyper2: Hyper2 · M920q {shape: image; icon: ${di}/proxmox.svg}
  hyper3: Hyper3 · M920 Tiny {shape: image; icon: ${di}/proxmox.svg}
  nas: Synology · 60TB {shape: image; icon: ${di}/synology.svg}
  habox: HA Mini-PC {shape: image; icon: ${di}/home-assistant.svg}
}

# ═════════════ FLOWS ═════════════

# ── Traffic / ingress (blue) ──
internet -> edge.modem: WAN {style: {stroke: "#0284c7"; stroke-width: 3}}
edge.modem -> edge.gw: translates WAN → LAN {style: {stroke: "#0284c7"; stroke-width: 3}}
edge.gw -> edge.sw {style: {stroke: "#475569"; stroke-width: 2}}
edge.sw -> hw: LAN {style: {stroke: "#475569"; stroke-width: 2}}
edge.sw -> edge.ap {style: {stroke: "#475569"}}
edge.gw -> net.traefik: ingress {style: {stroke: "#0284c7"; stroke-width: 3}}
net.cilium -> net.traefik: LB IP · L2 + LBIPAM {style: {stroke: "#0891b2"; stroke-dash: 3}}
net.traefik -> sites: HTTP routes {style: {stroke: "#0284c7"; stroke-width: 2}}
net.traefik -> media.seerr {style: {stroke: "#0284c7"}}
net.traefik -> media.plex {style: {stroke: "#0284c7"}}
net.traefik -> obs.grafana {style: {stroke: "#0284c7"}}

# ── TLS / DNS (cyan dashed) ──
net.cert -> net.traefik: certs {style: {stroke: "#0891b2"; stroke-dash: 4}}
net.cert -> cloudflare: DNS-01 {style: {stroke: "#0891b2"; stroke-dash: 4}}
net.externaldns -> cloudflare: CNAME records {style: {stroke: "#0891b2"; stroke-dash: 4}}
cloudflare -> letsencrypt: ACME {style: {stroke: "#0891b2"; stroke-dash: 4}}

# ── GitOps (indigo dashed) ──
github -> ops.argocd: git push {style: {stroke: "#4f46e5"; stroke-width: 2; stroke-dash: 4}}
github -> ghcr: build & push image {style: {stroke: "#4f46e5"; stroke-width: 2; stroke-dash: 4}}
ghcr -> ops.kargo: watch images {style: {stroke: "#4f46e5"; stroke-dash: 4}}
ops.kargo -> github: promote (git push) {style: {stroke: "#4f46e5"; stroke-dash: 4}}
ghcr -> sites: image pull {style: {stroke: "#4f46e5"; stroke-dash: 4}}
ops.argocd -> sites: deploys {style: {stroke: "#4f46e5"; stroke-dash: 4}}
ops.argocd -> media: deploys {style: {stroke: "#4f46e5"; stroke-dash: 4}}
ops.argocd -> net: deploys {style: {stroke: "#4f46e5"; stroke-dash: 4}}
ops.argocd -> obs: deploys {style: {stroke: "#4f46e5"; stroke-dash: 4}}
ops.rollouts -> sites: canary / blue-green {style: {stroke: "#4f46e5"; stroke-dash: 4}}

# ── Autoscaling (indigo) ──
# Cron scaling: portfolio & blog 1↔3 off-hours, headroom 0↔1 overnight.
ops.keda -> sites: cron scale 0↔N {style: {stroke: "#4f46e5"; stroke-width: 2}}
# HTTP wake-from-zero: KEDA's external scaler reads pending requests from the
# interceptor; traffic to idle apps routes through it and wakes them 0→1.
ops.keda -> net.interceptor: HTTP scaler {style: {stroke: "#4f46e5"; stroke-width: 2; stroke-dash: 4}}
net.traefik -> net.interceptor: wake-from-zero routes {style: {stroke: "#0284c7"; stroke-width: 2}}
net.interceptor -> sites: wake 0↔1 {style: {stroke: "#4f46e5"; stroke-width: 2}}

# ── Secrets & reload (purple) ──
bitwarden -> ops.eso: secrets {style: {stroke: "#7c3aed"; stroke-width: 2}}
ops.eso -> sites.workout {style: {stroke: "#7c3aed"}}
ops.eso -> media.gluetun {style: {stroke: "#7c3aed"}}
ops.eso -> obs.grafana {style: {stroke: "#7c3aed"}}
ops.eso -> obs.alertmanager {style: {stroke: "#7c3aed"}}
ops.eso -> sec.authentik {style: {stroke: "#7c3aed"}}
ops.eso -> sec.sidekick {style: {stroke: "#7c3aed"}}
ops.eso -> net.cert {style: {stroke: "#7c3aed"}}
ops.eso -> net.externaldns {style: {stroke: "#7c3aed"}}
ops.reloader -> sec.sidekick: reload {style: {stroke: "#9333ea"; stroke-dash: 4}}
ops.reloader -> media.gluetun: reload {style: {stroke: "#9333ea"; stroke-dash: 4}}

# ── Media interactions (pink) ──
media.seerr -> media.plex: library {style: {stroke: "#db2777"}}
media.seerr -> media.sonarr: requests {style: {stroke: "#db2777"}}
media.seerr -> media.radarr: requests {style: {stroke: "#db2777"}}
media.prowlarr -> media.sonarr: indexers {style: {stroke: "#db2777"}}
media.prowlarr -> media.radarr: indexers {style: {stroke: "#db2777"}}
media.prowlarr -> media.flaresolverr {style: {stroke: "#db2777"}}
media.sonarr -> media.qbit: downloads {style: {stroke: "#db2777"}}
media.radarr -> media.qbit: downloads {style: {stroke: "#db2777"}}
media.bazarr -> media.sonarr: subtitles {style: {stroke: "#db2777"}}
media.bazarr -> media.radarr: subtitles {style: {stroke: "#db2777"}}
media.tautulli -> media.plex: stats {style: {stroke: "#db2777"}}
media.qbit -> media.gluetun: routed via {style: {stroke: "#ea580c"; stroke-width: 2}}
media.gluetun -> pia: VPN tunnel {style: {stroke: "#ea580c"; stroke-width: 2; stroke-dash: 4}}

# ── Data (blue) ──
sites.workout -> sites.postgres: SQL {style: {stroke: "#0369a1"; stroke-width: 2}}

# ── AI / LLM (fuchsia) — both wake from zero via the interceptor ──
# open-webui wakes on inbound traffic; it then calls ollama through the same
# interceptor (OLLAMA_BASE_URL → ollama-wake) so ollama wakes only when used.
net.interceptor -> ai.openwebui: wake 0↔1 {style: {stroke: "#4f46e5"; stroke-width: 2}}
ai.openwebui -> net.interceptor: ollama API {style: {stroke: "#c026d3"; stroke-width: 2}}
net.interceptor -> ai.ollama: wake 0↔1 {style: {stroke: "#4f46e5"; stroke-width: 2}}
ops.argocd -> ai: deploys {style: {stroke: "#4f46e5"; stroke-dash: 4}}
ai -> store.nfscsi: models + data {style: {stroke: "#d97706"}}

# ── Observability (teal) ──
net.traefik -> obs.otel: OTLP traces {style: {stroke: "#0d9488"}}
obs.otel -> obs.tempo: export {style: {stroke: "#0d9488"; stroke-dash: 2}}
obs.prometheus -> net.traefik: scrape {style: {stroke: "#0d9488"; stroke-dash: 2}}
obs.prometheus -> sec.falco: scrape {style: {stroke: "#0d9488"; stroke-dash: 2}}
obs.prometheus -> obs.loki: scrape {style: {stroke: "#0d9488"; stroke-dash: 2}}
obs.prometheus -> net.cilium: scrape {style: {stroke: "#0d9488"; stroke-dash: 2}}
obs.grafana -> obs.prometheus: query {style: {stroke: "#0d9488"}}
obs.grafana -> obs.loki: query {style: {stroke: "#0d9488"}}
obs.grafana -> obs.tempo: query {style: {stroke: "#0d9488"}}
obs.prometheus -> obs.alertmanager: alerts {style: {stroke: "#0d9488"}}
obs.alertmanager -> discord: notify {style: {stroke: "#dc2626"; stroke-dash: 4}}

# ── Security (red dashed) ──
sec.falco -> sec.sidekick: events {style: {stroke: "#dc2626"}}
sec.sidekick -> discord: alerts {style: {stroke: "#dc2626"; stroke-dash: 4}}
sec.falco -> hw: syscalls {style: {stroke: "#dc2626"; stroke-dash: 4}}
sec.authentik -> net.traefik: forward-auth {style: {stroke: "#dc2626"; stroke-dash: 4}}

# ── Storage (amber) ──
media.plex -> store.nfscsi: media {style: {stroke: "#d97706"}}
sites.abs -> store.nfscsi: audiobooks {style: {stroke: "#d97706"}}
sites.postgres -> store.pcsi: block {style: {stroke: "#d97706"}}
store.nfscsi -> hw.nas: NFS {style: {stroke: "#d97706"; stroke-width: 2}}
store.pcsi -> hw.hyper1: block {style: {stroke: "#d97706"; stroke-width: 2}}

# ── Home automation (green) ──
edge.sw -> home.ha {style: {stroke: "#16a34a"}}
home.ha -> home.adguard: DNS add-on {style: {stroke: "#16a34a"; stroke-dash: 4}}
edge.gw -> home.adguard: DNS queries {style: {stroke: "#0891b2"; stroke-dash: 3}}
home.ha -> smart: Zigbee · BLE · Wi-Fi {style: {stroke: "#16a34a"}}

# Inline-legibility: `direction: down` keeps the graph narrow-and-tall so GitHub's
# width-fit downscale leaves bigger labels; this glob bumps every leaf label, and
# the explicit container/title sizes above override it (explicit > glob > class).
# Layout engine is set via the render command's `--layout elk` flag, since a `**`
# glob can't coexist with a `vars.d2-config` block.
**: {
  style.font-size: 26
}
