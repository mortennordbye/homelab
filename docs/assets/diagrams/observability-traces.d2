# Traefik's and logeverylift's traces through Alloy's filters into Tempo. See platform/observability/README.md.
direction: down
vars: {
  di: https://raw.githubusercontent.com/homarr-labs/dashboard-icons/main/svg
  k8s: https://raw.githubusercontent.com/kubernetes/community/master/icons/svg/resources/unlabeled
  ify: https://api.iconify.design
}

style.fill: "#0f1410"

classes: {
  card: {
    label.near: bottom-center
    style: {fill: "#191f1a"; stroke: "#2a382c"; font-color: "#e9ebe9"; border-radius: 8; font-size: 16}
  }
  aside: {
    label.near: bottom-center
    style: {fill: "#0f1410"; stroke: "#c09955"; stroke-dash: 4; font-color: "#a1ada3"; border-radius: 8; font-size: 14}
  }
  group: {
    label.near: top-left
    style: {fill: "#0f1410"; stroke: "#2a382c"; font-color: "#a1ada3"; border-radius: 12; font-size: 15}
  }
}

(** -> **)[*].style: {stroke: "#65a16e"; font-color: "#a1ada3"; font-size: 14}

traefik: "Traefik\nevery request, both gateways" {class: card; icon: ${di}/traefik.svg}
app: "logeverylift\nroutes, Postgres, fetch" {class: card; icon: ${di}/nextjs-light.svg}

alloy: Alloy {
  class: group
  sample: "tail sampling\nper whole trace" {class: card; icon: ${ify}/tabler/filter.svg?color=%23a1ada3&height=64}
  strip: "transform\nstrip attributes" {class: card; icon: ${ify}/tabler/eraser.svg?color=%23a1ada3&height=64}
  sample -> strip: kept
}

dropped: "dropped\nmonitoring UIs, blackbox\nand kubelet probes" {class: aside; icon: ${ify}/tabler/trash.svg?color=%23a1ada3&height=64}
removed: "removed\nprocess, OS, pod UID, ports,\nclient IPs, query strings" {class: aside; icon: ${ify}/tabler/trash.svg?color=%23a1ada3&height=64}

tempo: "Tempo\n24 h, local-blocks generator" {class: card; icon: ${di}/tempo.svg}
grafana: "Grafana\nDrilldown, Explore,\nlogeverylift Traces" {class: card; icon: ${di}/grafana.svg}

traefik -> alloy.sample: OTLP gRPC
traefik -> app: traceparent
app -> alloy.sample: OTLP HTTP
alloy.sample -> dropped: matched
alloy.strip -> removed: attributes
alloy.strip -> tempo: OTLP
tempo -> grafana: TraceQL
