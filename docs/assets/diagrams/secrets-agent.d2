# How agents and the cluster each reach Bitwarden, and where human sign-ins live. See platform/secrets/README.md.
direction: down
vars: {
  di: https://raw.githubusercontent.com/homarr-labs/dashboard-icons/main/svg
  k8s: https://raw.githubusercontent.com/kubernetes/community/master/icons/svg/resources/unlabeled
  ify: https://api.iconify.design
}

style.fill: "#0f1410"

classes: {
  card: {
    label.near: bottom-center
    style: {fill: "#191f1a"; stroke: "#2a382c"; font-color: "#e9ebe9"; border-radius: 8; font-size: 16}
  }
  aside: {
    label.near: bottom-center
    style: {fill: "#0f1410"; stroke: "#c09955"; stroke-dash: 4; font-color: "#a1ada3"; border-radius: 8; font-size: 14}
  }
}

(** -> **)[*].style: {stroke: "#65a16e"; font-color: "#a1ada3"; font-size: 14}

vault: "Bitwarden vault, folder Homelab\nhuman sign-ins, bws agent token" {class: card; icon: ${di}/bitwarden.svg}
setup: "bws-token setup\nonce per machine" {class: card; icon: ${ify}/tabler/terminal-2.svg?color=%23a1ada3&height=64}
local: "local copy\nKeychain or ~/.config/bws/token" {class: card; icon: ${ify}/tabler/lock-password.svg?color=%23a1ada3&height=64}
agent: "agent or script\nreads it with bws-token" {class: card; icon: ${ify}/tabler/robot.svg?color=%23a1ada3&height=64}

sm: "Bitwarden Secrets Manager\nproject Homelab" {class: card; icon: ${di}/bitwarden.svg}

eso: "External Secrets Operator\ntoken bw-auth-token" {class: card; icon: https://raw.githubusercontent.com/external-secrets/external-secrets/main/assets/eso-round-logo.svg}
secret: "Secret\nrefreshed hourly" {class: card; icon: ${k8s}/secret.svg}
pod: pod env {class: card; icon: ${k8s}/pod.svg}

vaultadd: "vault-add\nrun by a person" {class: aside; icon: ${ify}/tabler/user.svg?color=%23a1ada3&height=64}

vault -> setup: master password
setup -> local: token
local -> agent
agent -> sm: create, rotate
sm -> eso: same project
eso -> secret -> pod
sm -> vaultadd: new sign-in
vaultadd -> vault: login item
