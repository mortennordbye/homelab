# Who writes to this repo, the PR checks that gate main, and the workflows a push to main starts. See platform/delivery/ci.md.
direction: down
vars: {
  di: https://raw.githubusercontent.com/homarr-labs/dashboard-icons/main/svg
  k8s: https://raw.githubusercontent.com/kubernetes/community/master/icons/svg/resources/unlabeled
  ify: https://api.iconify.design
}

style.fill: "#0f1410"

classes: {
  card: {
    label.near: bottom-center
    style: {fill: "#191f1a"; stroke: "#2a382c"; font-color: "#e9ebe9"; border-radius: 8; font-size: 16}
  }
  aside: {
    label.near: bottom-center
    style: {fill: "#0f1410"; stroke: "#c09955"; stroke-dash: 4; font-color: "#a1ada3"; border-radius: 8; font-size: 14}
  }
}

(** -> **)[*].style: {stroke: "#65a16e"; font-color: "#a1ada3"; font-size: 14}

person: "Morten\nfeature branch" {class: card; width: 180; icon: ${ify}/tabler/user.svg?color=%23a1ada3&height=64}
renovate: "Renovate\ndependency bumps" {class: card; width: 180; icon: ${di}/renovate.svg}
certs: "sync-certs\ndaily workflow" {class: card; width: 180; icon: ${ify}/logos/github-actions.svg}
kargo: "Kargo\nprod promotion" {class: card; width: 180; icon: https://raw.githubusercontent.com/akuity/kargo/main/ui/public/kargo-logo-head-only.png}

checks: "PR checks\nbuild, terraform validate,\ndependency review,\ndocs --strict" {class: card; icon: ${ify}/logos/github-actions.svg}
automerge: "kargo-automerge\nif app label allowed" {class: card; icon: ${ify}/logos/github-actions.svg}

main: "main" {class: card; width: 180; icon: ${di}/git.svg}

builds: "build-portfolio\nbuild-blog\nimage to GHCR" {class: card; width: 180; icon: ${di}/github-light.svg}
render: "render-assets\nD2 to SVG and PNG" {class: card; width: 180; icon: ${ify}/logos/github-actions.svg}
docs: "docs\nto docs.nordbye.it" {class: card; width: 180; icon: ${ify}/tabler/book.svg?color=%23a1ada3&height=64}
argocd: "Argo CD\nsyncs k8s/talos" {class: card; width: 180; icon: ${di}/argo-cd.svg}

person -> checks: PR
renovate -> checks: PR
certs -> checks: PR
kargo -> automerge: PR
checks -> main: merge
automerge -> main: squash merge
main -> builds: "portfolio/, blog/"
main -> render: "*.d2"
main -> docs: "docs/"
main -> argocd: manifests
render -> main: commit
builds -> kargo: "0.0.<run>"
