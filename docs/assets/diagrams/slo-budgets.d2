# Where the SLIs come from and what an error budget changes. See platform/observability/slos.md.
direction: down
vars: {
  di: https://raw.githubusercontent.com/homarr-labs/dashboard-icons/main/svg
  k8s: https://raw.githubusercontent.com/kubernetes/community/master/icons/svg/resources/unlabeled
  ify: https://api.iconify.design
}

style.fill: "#0f1410"

classes: {
  card: {
    label.near: bottom-center
    style: {fill: "#191f1a"; stroke: "#2a382c"; font-color: "#e9ebe9"; border-radius: 8; font-size: 16}
  }
  aside: {
    label.near: bottom-center
    style: {fill: "#0f1410"; stroke: "#c09955"; stroke-dash: 4; font-color: "#a1ada3"; border-radius: 8; font-size: 14}
  }
}

(** -> **)[*].style: {stroke: "#65a16e"; font-color: "#a1ada3"; font-size: 14}

probe: "blackbox probes\nvia public DNS, Cloudflare" {class: card; width: 205; icon: ${ify}/tabler/world-www.svg?color=%23a1ada3&height=64}
traefik: "Traefik\n5xx and latency per site" {class: card; width: 205; icon: ${di}/traefik.svg}
platform: "platform state\nDNS, certs, secrets, GitOps" {class: card; width: 205; icon: ${di}/kubernetes.svg}

prometheus: "Prometheus\n7 days" {class: card; icon: ${di}/prometheus.svg}
pyrra: "Pyrra\nSLOs as rules" {class: card; width: 205; icon: https://raw.githubusercontent.com/pyrra-dev/pyrra/main/ui/public/logo192.png}

alerts: "ErrorBudgetBurn\nprobe SLO only" {class: card; width: 205; icon: ${di}/alertmanager.svg}
grafana: "Pyrra UI, SPOG\nbudget left" {class: card; width: 205; icon: ${di}/grafana.svg}
kargo: "Kargo prod promotion\nPR labelled by budget" {class: card; width: 205; icon: https://raw.githubusercontent.com/akuity/kargo/main/ui/public/kargo-logo-head-only.png}
automerge: "auto-merge\nskips slo/budget-low" {class: aside; width: 205; icon: ${ify}/tabler/git-merge.svg?color=%23a1ada3&height=64}

probe -> prometheus: probe_success
traefik -> prometheus: request metrics
platform -> prometheus: state metrics
pyrra -> prometheus: rules
prometheus -> alerts: 14x, 7x burn
prometheus -> grafana: budgets
prometheus -> kargo: budget query
kargo -> automerge: label
