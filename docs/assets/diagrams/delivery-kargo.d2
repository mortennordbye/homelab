# From a push to a running image: CI builds, Kargo promotes, Argo CD syncs. See platform/delivery/kargo.md.
direction: down
vars: {
  di: https://raw.githubusercontent.com/homarr-labs/dashboard-icons/main/svg
  k8s: https://raw.githubusercontent.com/kubernetes/community/master/icons/svg/resources/unlabeled
  ify: https://api.iconify.design
}

style.fill: "#0f1410"

classes: {
  card: {
    label.near: bottom-center
    style: {fill: "#191f1a"; stroke: "#2a382c"; font-color: "#e9ebe9"; border-radius: 8; font-size: 16}
  }
  aside: {
    label.near: bottom-center
    style: {fill: "#0f1410"; stroke: "#c09955"; stroke-dash: 4; font-color: "#a1ada3"; border-radius: 8; font-size: 14}
  }
}

(** -> **)[*].style: {stroke: "#65a16e"; font-color: "#a1ada3"; font-size: 14}

ci: GitHub {
  label.near: top-left
  style: {fill: "#0f1410"; stroke: "#2a382c"; font-color: "#a1ada3"; border-radius: 12; font-size: 15}
  push: "push to main\nunder portfolio/ or blog/, or an app repo" {class: card; icon: ${di}/git.svg}
  build: "build workflow\nlint, Docker build" {class: card; icon: ${ify}/logos/github-actions.svg}
  ghcr: "GHCR\n:<short-sha> and :0.0.<run>" {class: card; icon: ${di}/github-light.svg}
  push -> build -> ghcr
}

kargo: "Kargo, project <app>-cd" {
  label.near: top-left
  style: {fill: "#0f1410"; stroke: "#2a382c"; font-color: "#a1ada3"; border-radius: 12; font-size: 15}
  warehouse: "Warehouse\npolls every 1m, picks the greatest 0.0.<n>" {class: card; icon: https://raw.githubusercontent.com/akuity/kargo/main/ui/public/kargo-logo-head-only.png}
  stage: "stage Stage\npromote-to-argocd" {class: card; icon: https://raw.githubusercontent.com/akuity/kargo/main/ui/public/kargo-logo-head-only.png}
  smoke: "smoke test\ncurl Job from an AnalysisTemplate" {class: card; icon: ${k8s}/job.svg}
  prod: "prod Stage\npromote-via-pr" {class: card; icon: https://raw.githubusercontent.com/akuity/kargo/main/ui/public/kargo-logo-head-only.png}
  warehouse -> stage: auto-promote
  stage -> smoke
  smoke -> prod: verified Freight
}

main: "homelab main\nnewTag in the app's kustomization.yaml" {class: card; icon: ${di}/git.svg}
pr: "promotion PR\nkargo/promotion/... branch" {class: card; icon: ${di}/github-light.svg}
automerge: "kargo-automerge.yaml\napps in KARGO_AUTOMERGE_APPS" {class: aside; icon: ${ify}/logos/github-actions.svg}
argocd: "Argo CD\nargocd-update, argocd-wait" {class: card; icon: ${di}/argo-cd.svg}
purge: "Cloudflare cache purge\nportfolio and blog prod" {class: aside; icon: ${di}/cloudflare.svg}

ci.ghcr -> kargo.warehouse: new Freight
kargo.stage -> main: push bump
kargo.prod -> pr: open PR, wait
automerge -> pr: {style.stroke-dash: 4}
pr -> main: merge is the deploy gate
main -> argocd: sync
kargo.prod -> purge: {style.stroke-dash: 4}
