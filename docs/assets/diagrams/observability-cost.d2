# How usage becomes an estimated cost on the SPOG dashboard. See platform/observability/costs.md.
direction: down
vars: {
  di: https://raw.githubusercontent.com/homarr-labs/dashboard-icons/main/svg
  k8s: https://raw.githubusercontent.com/kubernetes/community/master/icons/svg/resources/unlabeled
  ify: https://api.iconify.design
  kyverno: https://raw.githubusercontent.com/cncf/artwork/main/projects/kyverno/icon/color/kyverno-icon-color.svg
}

style.fill: "#0f1410"

classes: {
  card: {
    label.near: bottom-center
    style: {fill: "#191f1a"; stroke: "#2a382c"; font-color: "#e9ebe9"; border-radius: 8; font-size: 16}
  }
  aside: {
    label.near: bottom-center
    style: {fill: "#0f1410"; stroke: "#c09955"; stroke-dash: 4; font-color: "#a1ada3"; border-radius: 8; font-size: 14}
  }
}

(** -> **)[*].style: {stroke: "#65a16e"; font-color: "#a1ada3"; font-size: 14}

usage: "kube-state-metrics, cAdvisor\nrequests, usage, capacity" {class: card; icon: ${di}/kubernetes.svg}
price: "electricity-price\nNO1 spot price" {class: card; icon: ${ify}/tabler/bolt.svg?color=%23a1ada3&height=64}
prometheus: Prometheus {class: card; icon: ${di}/prometheus.svg}
rates: "custom-pricing-model\nrates from an estimated 100 W" {class: aside; icon: ${k8s}/cm.svg}
opencost: "OpenCost\nallocation and node prices" {class: card; icon: ${ify}/tabler/pig-money.svg?color=%23a1ada3&height=64}
ui: "OpenCost UI\nopencost.local.bigd.no" {class: card; icon: ${ify}/tabler/pig-money.svg?color=%23a1ada3&height=64}
grafana: "Grafana SPOG\nCost, estimated row" {class: card; icon: ${di}/grafana.svg}

usage -> prometheus
price -> prometheus
prometheus -> opencost: usage
rates -> opencost: fixed rates
opencost -> prometheus: price and allocation metrics
opencost -> ui
prometheus -> grafana
