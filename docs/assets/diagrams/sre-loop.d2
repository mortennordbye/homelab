# How a problem is caught, paged, fixed and learned from. See platform/observability/sre.md.
direction: down
vars: {
  di: https://raw.githubusercontent.com/homarr-labs/dashboard-icons/main/svg
  k8s: https://raw.githubusercontent.com/kubernetes/community/master/icons/svg/resources/unlabeled
  ify: https://api.iconify.design
}

style.fill: "#0f1410"

classes: {
  card: {
    label.near: bottom-center
    style: {fill: "#191f1a"; stroke: "#2a382c"; font-color: "#e9ebe9"; border-radius: 8; font-size: 16}
  }
  group: {
    label.near: top-left
    style: {fill: "#0f1410"; stroke: "#2a382c"; font-color: "#a1ada3"; border-radius: 12; font-size: 15}
  }
  aside: {
    label.near: bottom-center
    style: {fill: "#0f1410"; stroke: "#c09955"; stroke-dash: 4; font-color: "#a1ada3"; border-radius: 8; font-size: 14}
  }
}

(** -> **)[*].style: {stroke: "#65a16e"; font-color: "#a1ada3"; font-size: 14}

signals: "Traefik, blackbox probes,\nexporters" {class: card; icon: ${ify}/tabler/activity.svg?color=%23a1ada3&height=64}
pyrra: "Pyrra\nSLOs, error budgets" {class: card; icon: https://raw.githubusercontent.com/pyrra-dev/pyrra/main/ui/public/logo192.png}
prometheus: "Prometheus\nalert rules" {class: card; icon: ${di}/prometheus.svg}
alertmanager: Alertmanager {class: card; icon: ${di}/alertmanager.svg}
review: "Weekly review\nwarnings, budgets, OOMs" {class: aside; icon: ${ify}/tabler/calendar-check.svg?color=%23a1ada3&height=64}
discord: "Discord\n#homelab-alerts" {class: card; icon: ${di}/discord.svg}
runbook: "Runbook\nin the docs" {class: card; icon: ${ify}/tabler/book.svg?color=%23a1ada3&height=64}
incident: "Postmortem\nincidents.md" {class: aside; icon: ${ify}/tabler/file-alert.svg?color=%23a1ada3&height=64}
git: "Fix in Git" {class: card; icon: ${di}/git.svg}
argocd: "Argo CD sync\ndeploy marker in Grafana" {class: card; icon: ${di}/argo-cd.svg}

signals -> prometheus: scraped
pyrra -> prometheus: burn-rate rules
prometheus -> alertmanager: critical
prometheus -> review: warnings
alertmanager -> discord: page
discord -> runbook: link
runbook -> git: mitigate
runbook -> incident: criteria met
incident -> git: actions
review -> git: tune
git -> argocd: sync
