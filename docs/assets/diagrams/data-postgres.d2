# Postgres 18 behind logeverylift: data, credentials and backups. See platform/data/postgres.md.
direction: down
vars: {
  di: https://raw.githubusercontent.com/homarr-labs/dashboard-icons/main/svg
  k8s: https://raw.githubusercontent.com/kubernetes/community/master/icons/svg/resources/unlabeled
  ify: https://api.iconify.design
}

style.fill: "#0f1410"

classes: {
  card: {
    label.near: bottom-center
    style: {fill: "#191f1a"; stroke: "#2a382c"; font-color: "#e9ebe9"; border-radius: 8; font-size: 16}
  }
  aside: {
    label.near: bottom-center
    style: {fill: "#0f1410"; stroke: "#c09955"; stroke-dash: 4; font-color: "#a1ada3"; border-radius: 8; font-size: 14}
  }
}

(** -> **)[*].style: {stroke: "#65a16e"; font-color: "#a1ada3"; font-size: 14}

secret: "Secret logeverylift-secret\nExternalSecret from Bitwarden" {class: card; icon: https://raw.githubusercontent.com/external-secrets/external-secrets/main/assets/eso-round-logo.svg}
app: "Deployment\nlogeverylift-app" {class: card; width: 172; icon: ${k8s}/deploy.svg}
postgres: "Deployment postgres\npostgres:18-alpine\nService :5432" {class: card; width: 172; icon: ${di}/postgresql.svg}
init: "initContainer\nfix-nfs-ownership\nchown 70:70\nchmod 700" {class: aside; width: 172; icon: ${k8s}/pod.svg}
pvc: "PVC postgres-pvc-18\nsyno-nfs-csi\n/var/lib/postgresql" {class: card; width: 172; icon: ${k8s}/pvc.svg}
cron: "CronJob\nlogeverylift-\ndb-backup\nnightly 00:45" {class: card; width: 172; icon: ${k8s}/cronjob.svg}
nas: "NAS k8s-backups\npostgres/logeverylift/\n30 days" {class: card; width: 172; icon: ${di}/synology.svg}
gdrive: "Google Drive\nHyper Backup\n03:20" {class: card; width: 172; icon: ${di}/google-drive.svg}
exporter: "postgres-exporter\nown Deployment\n:9187 to Prometheus" {class: card; width: 172; icon: ${di}/prometheus.svg}
restore: "restore-test\nmonthly, into\nscratch Postgres" {class: card; width: 172; icon: ${ify}/tabler/restore.svg?color=%23a1ada3&height=64}

secret -> app: password
secret -> postgres: password
secret -> cron: password
secret -> exporter: password
app -> postgres: SQL
exporter -> postgres: pg_stat_*
init -> pvc: chowns
postgres -> pvc: data
cron -> postgres: pg_dump
cron -> nas: dump file
nas -> gdrive: offsite
nas -> restore: newest dump
