# Verksted pod: ingress, containers, storage and what sessions can reach. See apps/verksted/README.md.
direction: down
vars: {
  di: https://raw.githubusercontent.com/homarr-labs/dashboard-icons/main/svg
  k8s: https://raw.githubusercontent.com/kubernetes/community/master/icons/svg/resources/unlabeled
  ify: https://api.iconify.design
}

style.fill: "#0f1410"

classes: {
  card: {
    label.near: bottom-center
    style: {fill: "#191f1a"; stroke: "#2a382c"; font-color: "#e9ebe9"; border-radius: 8; font-size: 16}
  }
  aside: {
    label.near: bottom-center
    style: {fill: "#0f1410"; stroke: "#c09955"; stroke-dash: 4; font-color: "#a1ada3"; border-radius: 8; font-size: 14}
  }
}

(** -> **)[*].style: {stroke: "#65a16e"; font-color: "#a1ada3"; font-size: 14}

classes: {
  ns: {
    style: {fill: "#0f1410"; stroke: "#2a382c"; font-color: "#a1ada3"; border-radius: 12; font-size: 16}
  }
}

user: "browser\nLAN or Tailscale" {class: card; icon: ${di}/tailscale-light.svg}
traefik: "Traefik private gateway\nverksted.local.bigd.no, no auth" {class: card; icon: ${di}/traefik.svg}

pod: "verksted pod, one replica" {
  class: ns
  app: "verksted\ntmux agent sessions, root" {class: card; icon: ${ify}/tabler/terminal-2.svg?color=%23a1ada3&height=64}
  dind: "dind\nprivileged Docker daemon" {class: card; icon: ${di}/docker.svg}
  app -> dind: "tcp localhost:2375"
}

reach: sessions reach {
  class: ns
  kube: "Kubernetes API\nServiceAccount verksted: view,\nread Argo and Kargo, promote" {class: card; icon: ${di}/kubernetes.svg}
  internet: "internet\nrepos, registries, image pulls\nLLM APIs" {class: card; icon: ${ify}/tabler/world.svg?color=%23a1ada3&height=64}
  gate: "reelsmith gateway\nnightly render uploads" {class: aside; icon: ${ify}/tabler/movie.svg?color=%23a1ada3&height=64}
}

storage: mounts {
  class: ns
  data: "PVC verksted-data, 20Gi\n/data in both containers" {class: card; icon: ${k8s}/pvc.svg}
  docker: "emptyDir /var/lib/docker\ndind only" {class: aside; icon: ${k8s}/vol.svg}
  share: "NFS /volume1/shared-data\nreelsmith, backups rw\nshared ro" {class: card; icon: ${di}/synology.svg}
}

volsync: "VolSync restic\nPVC nightly 01:40 to the NAS" {class: aside; icon: ${di}/synology.svg}

user -> traefik -> pod.app
pod -> reach
pod -> storage
storage -> volsync: {style.stroke-dash: 4}
reach.kube -> reach.internet -> reach.gate: {style.opacity: 0}
storage.data -> storage.docker -> storage.share: {style.opacity: 0}
