# UniFi site: the three networks, what lives on each, the firewall holes between them and the WAN entry points. See platform/network/unifi.md.
direction: down
vars: {
  di: https://raw.githubusercontent.com/homarr-labs/dashboard-icons/main/svg
  k8s: https://raw.githubusercontent.com/kubernetes/community/master/icons/svg/resources/unlabeled
  ify: https://api.iconify.design
}

style.fill: "#0f1410"

classes: {
  card: {
    label.near: bottom-center
    style: {fill: "#191f1a"; stroke: "#2a382c"; font-color: "#e9ebe9"; border-radius: 8; font-size: 16}
  }
  aside: {
    label.near: bottom-center
    style: {fill: "#0f1410"; stroke: "#c09955"; stroke-dash: 4; font-color: "#a1ada3"; border-radius: 8; font-size: 14}
  }
  group: {label.near: top-left; style: {fill: "#0f1410"; stroke: "#2a382c"; font-color: "#a1ada3"; border-radius: 12; font-size: 15}}
}

(** -> **)[*].style: {stroke: "#65a16e"; font-color: "#a1ada3"; font-size: 14}

internet: "Internet\nddns.bigd.no, ddns.nordbye.it" {class: card; width: 200; icon: ${ify}/tabler/world.svg?color=%23a1ada3&height=64}
gateway: "Cloud Gateway Fiber 10.3.10.1\nWireGuard: 192.168.3.0/24" {class: card; width: 200; icon: ${di}/unifi.svg}

trusted: "Trusted: untagged, 10.3.10.0/24" {
  class: group
  label.near: bottom-left
  cluster: "Talos cluster .31-.36\nTraefik .101, Plex .103" {class: card; width: 150; icon: ${di}/kubernetes.svg}
  ha: "Home Assistant .15\nDNS for all networks" {class: card; width: 150; icon: ${di}/home-assistant.svg}
  nas: "NAS .10, PBS .11\nhyper1-3 .12-.14" {class: card; width: 150; icon: ${di}/synology.svg}
}

iot: "IoT: VLAN 20, 10.3.20.0/24, all else blocked" {
  class: group
  tv: "LG TV" {class: card; width: 150; icon: ${ify}/tabler/device-tv.svg?color=%23a1ada3&height=64}
  voice: "Voice PE" {class: card; width: 150; icon: ${ify}/tabler/microphone.svg?color=%23a1ada3&height=64}
  esp: "ESPHome, Sonos\nBT proxy" {class: card; width: 150; icon: ${di}/esphome.svg}
}

guest: "Guest: VLAN 1000, 192.168.100.0/24" {
  class: group
  label.near: bottom-left
  guests: "Eden-Guest clients\nL2 isolation" {class: card; width: 150; icon: ${ify}/tabler/users.svg?color=%23a1ada3&height=64}
}

internet -> gateway: "80, 443, 32400, 51820"
gateway -> guest.guests: "internet only"
gateway -> trusted.cluster: "Traefik, Plex"
trusted.ha -> iot.esp: "any"
iot.esp -> trusted.ha: "DNS, 8123"
iot.tv -> trusted.cluster: "32400, 443"
iot.voice -> trusted.cluster: "9090"
