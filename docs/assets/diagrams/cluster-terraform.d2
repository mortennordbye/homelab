# Terraform stacks: which root manages what, and the azurerm backend that holds their state. See platform/cluster/terraform.md.
direction: right
vars: {
  di: https://raw.githubusercontent.com/homarr-labs/dashboard-icons/main/svg
  k8s: https://raw.githubusercontent.com/kubernetes/community/master/icons/svg/resources/unlabeled
  ify: https://api.iconify.design
}

style.fill: "#0f1410"

classes: {
  card: {
    label.near: bottom-center
    style: {fill: "#191f1a"; stroke: "#2a382c"; font-color: "#e9ebe9"; border-radius: 8; font-size: 16}
  }
  aside: {
    label.near: bottom-center
    style: {fill: "#0f1410"; stroke: "#c09955"; stroke-dash: 4; font-color: "#a1ada3"; border-radius: 8; font-size: 14}
  }
  group: {label.near: top-left; style: {fill: "#0f1410"; stroke: "#2a382c"; font-color: "#a1ada3"; border-radius: 12; font-size: 15}}
}

(** -> **)[*].style: {stroke: "#65a16e"; font-color: "#a1ada3"; font-size: 14}

proxmox: "terraform/proxmox" {
  class: group
  grid-columns: 2
  grid-gap: 20
  datacenter: "hyper-cluster/datacenter\nDatacenter, node config" {class: card; width: 200; height: 140; icon: ${di}/proxmox-light.svg}
  talos: "hyper-cluster/k8s/talos\nTalos VMs, first Argo CD" {class: card; width: 200; height: 140; icon: ${di}/talos.svg}
  tailscale: "hyper-cluster/tailscale\nrouter VM, tailnet" {class: card; width: 200; height: 140; icon: ${di}/tailscale-light.svg}
  pbs: "pbs\nBackup Server" {class: card; width: 200; height: 140; icon: ${di}/proxmox-light.svg}
}

unifi: "terraform/unifi" {
  class: group
  grid-columns: 2
  grid-gap: 20
  network: "network\nthe UniFi site" {class: card; width: 200; height: 140; icon: ${di}/unifi.svg}
  dns: "dns\nlocal.bigd.no records" {class: card; width: 200; height: 140; icon: ${di}/unifi.svg}
}

cloudflare: "terraform/cloudflare" {
  class: group
  grid-columns: 2
  grid-gap: 20
  zones: "three zones: nordbye-it,\nbigd-no,\nlogeverylift-com" {class: card; width: 200; height: 140; icon: ${di}/cloudflare.svg}
  watchdog: "watchdog\nthe watchdog Worker" {class: card; width: 200; height: 140; icon: ${di}/cloudflare.svg}
}

backend: "sttfstatemvnhomelab\ncontainer tfstate\none key per stack" {class: card; width: 200; height: 150; icon: ${di}/azure.svg}

state: "terraform/azure/state\nrg-tfstate-homelab" {class: card; width: 230; height: 140; icon: ${di}/terraform.svg}

proxmox -> backend: "proxmox/*"
unifi -> backend: "unifi/*"
cloudflare -> backend: "cloudflare/*"
state -> backend: "creates"
