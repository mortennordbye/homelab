# How a wildcard certificate is issued and reaches a Gateway. See platform/network/certificates.md.
direction: down
vars: {
  di: https://raw.githubusercontent.com/homarr-labs/dashboard-icons/main/svg
  k8s: https://raw.githubusercontent.com/kubernetes/community/master/icons/svg/resources/unlabeled
  ify: https://api.iconify.design
}

style.fill: "#0f1410"

classes: {
  card: {
    label.near: bottom-center
    style: {fill: "#191f1a"; stroke: "#2a382c"; font-color: "#e9ebe9"; border-radius: 8; font-size: 16}
  }
  aside: {
    label.near: bottom-center
    style: {fill: "#0f1410"; stroke: "#c09955"; stroke-dash: 4; font-color: "#a1ada3"; border-radius: 8; font-size: 14}
  }
}

(** -> **)[*].style: {stroke: "#65a16e"; font-color: "#a1ada3"; font-size: 14}

bitwarden: "Bitwarden\nCloudflare API token" {class: card; icon: ${di}/bitwarden.svg}
cloudflare: "Cloudflare DNS\n_acme-challenge TXT" {class: card; icon: ${di}/cloudflare.svg}
letsencrypt: "Let's Encrypt\nACME production" {class: card; icon: ${di}/lets-encrypt.svg}

cm: "namespace cert-manager" {
  style: {fill: "#0f1410"; stroke: "#2a382c"; font-color: "#a1ada3"; border-radius: 8; font-size: 18}
  token: "cloudflare-token-secret\nExternalSecret" {class: card; icon: ${k8s}/secret.svg}
  issuer: "ClusterIssuer letsencrypt-prod\nDNS-01" {class: card; icon: ${di}/cert-manager.svg}
  pub: "bigd-no-tls\nnordbye-it-tls\nlogeverylift-com-tls" {class: card; icon: ${k8s}/secret.svg}
  priv: "local-bigd-no-tls" {class: card; icon: ${k8s}/secret.svg}
  grant: "ReferenceGrant\ntraefik-gateway-cert-access\nlets traefik read these secrets" {class: aside; icon: ${k8s}/crd.svg}
  token -> issuer
  issuer -> pub
  issuer -> priv
}

traefik: "namespace traefik" {
  style: {fill: "#0f1410"; stroke: "#2a382c"; font-color: "#a1ada3"; border-radius: 8; font-size: 18}
  gwpub: "traefik-gateway-public\nwebsecure, picked by SNI" {class: card; icon: ${di}/traefik.svg}
  gwpriv: "traefik-gateway-private\nlocal-bigd-no listener" {class: card; icon: ${di}/traefik.svg}
}

bitwarden -> cm.token
cm.issuer -> cloudflare: "writes TXT"
cm.issuer -> letsencrypt: "order"
letsencrypt -> cloudflare: "validates"
cm.pub -> traefik.gwpub
cm.priv -> traefik.gwpriv
