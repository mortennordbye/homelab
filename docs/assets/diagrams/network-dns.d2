# Who writes which DNS records, internal and public. See platform/network/dns.md.
direction: down
vars: {
  di: https://raw.githubusercontent.com/homarr-labs/dashboard-icons/main/svg
  k8s: https://raw.githubusercontent.com/kubernetes/community/master/icons/svg/resources/unlabeled
  ify: https://api.iconify.design
}

style.fill: "#0f1410"

classes: {
  card: {
    label.near: bottom-center
    style: {fill: "#191f1a"; stroke: "#2a382c"; font-color: "#e9ebe9"; border-radius: 8; font-size: 16}
  }
  aside: {
    label.near: bottom-center
    style: {fill: "#0f1410"; stroke: "#c09955"; stroke-dash: 4; font-color: "#a1ada3"; border-radius: 8; font-size: 14}
  }
}

(** -> **)[*].style: {stroke: "#65a16e"; font-color: "#a1ada3"; font-size: 14}

lan: "LAN (split horizon)" {
  style: {fill: "#0f1410"; stroke: "#2a382c"; font-color: "#a1ada3"; border-radius: 8; font-size: 18}
  records: "terraform/unifi/dns\nrecords.tf" {class: card; icon: ${di}/terraform.svg}
  clients: "terraform/unifi/network\nclients.tf reservations" {class: card; icon: ${di}/terraform.svg}
  resolver: "UniFi resolver 10.3.10.1\nlocal.bigd.no" {class: card; icon: ${di}/unifi.svg}
  client: "LAN client\nasks for <app>.local.bigd.no" {class: card; icon: ${ify}/tabler/devices.svg?color=%23a1ada3&height=64}
  gateway: "traefik-gateway-private\n10.3.10.102" {class: card; icon: ${di}/traefik.svg}
  records -> resolver: "VIP and app records"
  clients -> resolver: "generated host records"
  client -> resolver
  resolver -> gateway: "CNAME to the private gateway"
}

public: "public" {
  style: {fill: "#0f1410"; stroke: "#2a382c"; font-color: "#a1ada3"; border-radius: 8; font-size: 18}
  extdns: "external-dns\nHTTPRoutes on the public Gateway\nexcludes local.bigd.no" {class: card; icon: ${di}/kubernetes.svg}
  zone: "Cloudflare zone bigd.no\nCNAMEs to ddns.bigd.no" {class: card; icon: ${di}/cloudflare.svg}
  extdns -> zone: "upsert-only"
}
lan -> public: {style.opacity: 0}
