# Request paths through the two Traefik gateways. See platform/network/traefik.md.
direction: down
vars: {
  di: https://raw.githubusercontent.com/homarr-labs/dashboard-icons/main/svg
  k8s: https://raw.githubusercontent.com/kubernetes/community/master/icons/svg/resources/unlabeled
  ify: https://api.iconify.design
}

style.fill: "#0f1410"

classes: {
  card: {
    label.near: bottom-center
    style: {fill: "#191f1a"; stroke: "#2a382c"; font-color: "#e9ebe9"; border-radius: 8; font-size: 16}
  }
  aside: {
    label.near: bottom-center
    style: {fill: "#0f1410"; stroke: "#c09955"; stroke-dash: 4; font-color: "#a1ada3"; border-radius: 8; font-size: 14}
  }
}

(** -> **)[*].style: {stroke: "#65a16e"; font-color: "#a1ada3"; font-size: 14}

visitor: "visitor\nanywhere" {class: card; icon: ${ify}/tabler/world.svg?color=%23a1ada3&height=64}
lanclient: "LAN client\n*.local.bigd.no" {class: card; icon: ${ify}/tabler/devices.svg?color=%23a1ada3&height=64}
cloudflare: "Cloudflare edge\nproxied public hostnames" {class: card; icon: ${di}/cloudflare.svg}
unifi: "UniFi gateway\nforwards 80, 443 tcp/udp" {class: card; icon: ${di}/unifi.svg}

traefik: "namespace traefik" {
  style: {fill: "#0f1410"; stroke: "#2a382c"; font-color: "#a1ada3"; border-radius: 8; font-size: 18}
  public: "traefik-public\n10.3.10.101\nannounced by workers" {class: card; icon: ${k8s}/svc.svg}
  private: "traefik-private\n10.3.10.102\nannounced by control planes" {class: card; icon: ${k8s}/svc.svg}
  pods: "Traefik, 3 replicas, one per hypervisor\npublic :8000 :8443 (h3)\nprivate :8001 :8444" {class: card; icon: ${di}/traefik.svg}
  public -> pods
  private -> pods
}

filters: "middlewares in the app namespace, in order" {
  style: {fill: "#0f1410"; stroke: "#2a382c"; font-color: "#a1ada3"; border-radius: 8; font-size: 18}
  direction: right
  allow: "cloudflare-only\nipAllowList" {class: card; icon: ${di}/cloudflare.svg}
  rate: "ratelimit + inflight\nper client" {class: card; icon: ${di}/traefik.svg}
  compress: "compress\nbr, zstd, gzip" {class: card; icon: ${di}/traefik.svg}
  allow -> rate -> compress
}

authentik: "authentik-server.identity\nforwardAuth" {class: aside; icon: ${di}/authentik.svg}
interceptor: "KEDA interceptor\nscale-to-zero apps" {class: aside; icon: ${di}/keda.svg}
app: "app Service\nprivate routes skip\nthe middlewares" {class: card; icon: ${k8s}/svc.svg}

visitor -> cloudflare -> unifi -> traefik.public
lanclient -> traefik.private
traefik.pods -> filters.allow: public routes
filters.compress -> app
traefik.pods -> app
traefik.pods -> authentik
traefik.pods -> interceptor
interceptor -> app
