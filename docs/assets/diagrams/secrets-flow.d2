# Bitwarden to pod: how an ExternalSecret becomes a Secret. See platform/secrets/README.md.
direction: down
vars: {
  di: https://raw.githubusercontent.com/homarr-labs/dashboard-icons/main/svg
  k8s: https://raw.githubusercontent.com/kubernetes/community/master/icons/svg/resources/unlabeled
  ify: https://api.iconify.design
}

style.fill: "#0f1410"

classes: {
  card: {
    label.near: bottom-center
    style: {fill: "#191f1a"; stroke: "#2a382c"; font-color: "#e9ebe9"; border-radius: 8; font-size: 16}
  }
  aside: {
    label.near: bottom-center
    style: {fill: "#0f1410"; stroke: "#c09955"; stroke-dash: 4; font-color: "#a1ada3"; border-radius: 8; font-size: 14}
  }
}

(** -> **)[*].style: {stroke: "#65a16e"; font-color: "#a1ada3"; font-size: 14}

bitwarden: "Bitwarden Secrets Manager\norg morten-nordbye-lab, project Homelab" {class: card; icon: ${di}/bitwarden.svg}
git: "git (this repo)\nk8s/talos/apps/<app>/externalsecret.yaml\nremoteRef.key: <secret UUID>" {class: card; icon: ${di}/git.svg}
store: "ClusterSecretStore\nbitwarden-secretsmanager" {class: card; icon: https://raw.githubusercontent.com/external-secrets/external-secrets/main/assets/eso-round-logo.svg}
es: "ExternalSecret\nrefreshed hourly" {class: card; icon: https://raw.githubusercontent.com/external-secrets/external-secrets/main/assets/eso-round-logo.svg}
secret: Secret {class: card; icon: ${k8s}/secret.svg}
pod: pod env {class: card; icon: ${k8s}/pod.svg}

bitwarden -> store: machine account token
git -> es: Argo CD applies
store -> es -> secret -> pod
