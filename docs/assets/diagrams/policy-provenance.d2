# How a portfolio or blog image gets signed and verified. See platform/policy/README.md.
direction: down
vars: {
  di: https://raw.githubusercontent.com/homarr-labs/dashboard-icons/main/svg
  k8s: https://raw.githubusercontent.com/kubernetes/community/master/icons/svg/resources/unlabeled
  ify: https://api.iconify.design
  kyverno: https://raw.githubusercontent.com/cncf/artwork/main/projects/kyverno/icon/color/kyverno-icon-color.svg
}

style.fill: "#0f1410"

classes: {
  card: {
    label.near: bottom-center
    style: {fill: "#191f1a"; stroke: "#2a382c"; font-color: "#e9ebe9"; border-radius: 8; font-size: 16}
  }
  aside: {
    label.near: bottom-center
    style: {fill: "#0f1410"; stroke: "#c09955"; stroke-dash: 4; font-color: "#a1ada3"; border-radius: 8; font-size: 14}
  }
}

(** -> **)[*].style: {stroke: "#65a16e"; font-color: "#a1ada3"; font-size: 14}

build: "build-portfolio, build-blog\npush the image, attest\nprovenance (and an SBOM)" {class: card; icon: ${ify}/logos/github-actions.svg}
sigstore: "Sigstore public instance\nsigning certificate,\ntransparency log" {class: card; icon: ${ify}/tabler/certificate.svg?color=%23a1ada3&height=64}
ghcr: "GHCR\nimage, plus attestations under\nthe sha256-<digest> tag" {class: card; icon: ${di}/github-light.svg}
kargo: "Kargo and Argo CD\npromote and sync the tag" {class: card; icon: ${di}/argo-cd.svg}
api: "API server\nnew Pod" {class: card; icon: ${k8s}/pod.svg}
policy: "verify-first-party-images\nAudit, portfolio and blog" {class: card; icon: ${kyverno}}
report: "PolicyReport" {class: card; icon: ${k8s}/crd.svg}
grafana: "Grafana SPOG\nPolicy (Kyverno) row" {class: card; icon: ${di}/grafana.svg}

build -> sigstore: signs
build -> ghcr: pushes
ghcr -> kargo: new tag
kargo -> api: Deployment
api -> policy: webhook
ghcr -> policy: reads attestations
policy -> report: pass or fail
report -> grafana: through Policy Reporter and Prometheus
