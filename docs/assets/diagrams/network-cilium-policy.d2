# The traffic a typical app CiliumNetworkPolicy allows. See platform/network/cilium.md.
direction: right
vars: {
  di: https://raw.githubusercontent.com/homarr-labs/dashboard-icons/main/svg
  k8s: https://raw.githubusercontent.com/kubernetes/community/master/icons/svg/resources/unlabeled
  ify: https://api.iconify.design
}

style.fill: "#0f1410"

classes: {
  card: {
    label.near: bottom-center
    style: {fill: "#191f1a"; stroke: "#2a382c"; font-color: "#e9ebe9"; border-radius: 8; font-size: 16}
  }
  aside: {
    label.near: bottom-center
    style: {fill: "#0f1410"; stroke: "#c09955"; stroke-dash: 4; font-color: "#a1ada3"; border-radius: 8; font-size: 14}
  }
}

(** -> **)[*].style: {stroke: "#65a16e"; font-color: "#a1ada3"; font-size: 14}

traefik: "Traefik\nnamespace traefik" {class: card; icon: ${di}/traefik.svg}
interceptor: "KEDA interceptor\nscale-to-zero apps" {class: card; icon: ${di}/keda.svg}
probes: "host, health\nkubelet probes" {class: card; icon: ${di}/kubernetes.svg}
prometheus: "Prometheus\nnamespace monitoring" {class: card; icon: ${di}/prometheus.svg}

app: "app pod\ncontainer port" {class: card; icon: ${k8s}/pod.svg}

kubedns: "kube-dns\nL7 dns rule" {class: card; icon: ${di}/coredns.svg}
fqdns: "toFQDNs\nexternal names" {class: card; icon: ${ify}/tabler/world.svg?color=%23a1ada3&height=64}
hubble: "Hubble\nverdicts and drops\nto Prometheus" {class: aside; icon: ${di}/cilium.svg}

traefik -> app
interceptor -> app
probes -> app
prometheus -> app
app -> kubedns
app -> fqdns
app -> hubble: {style.stroke-dash: 4}
