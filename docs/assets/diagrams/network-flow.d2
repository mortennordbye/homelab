# Who talks to whom: traffic, delivery, secrets, telemetry and storage across the homelab.
# Colours are the docs site palette (assets/stylesheets/theme.css).
# Solid edges carry requests or data; dashed edges are control: deploys, secrets, DNS, alerts.
# Edges stay between groups: an edge into a grid cell drops ELK layering and flattens the sheet.
# Generic icons come from Iconify with the colour set in the URL, since D2 cannot recolour them.
direction: down
vars: {
  di: https://raw.githubusercontent.com/homarr-labs/dashboard-icons/main/svg
  dipng: https://raw.githubusercontent.com/homarr-labs/dashboard-icons/main/png
  sh: https://raw.githubusercontent.com/selfhst/icons/main/svg
  ify: https://api.iconify.design
  eso: https://raw.githubusercontent.com/external-secrets/external-secrets/main/assets/eso-round-logo.svg
  falco: https://raw.githubusercontent.com/cncf/artwork/main/projects/falco/icon/color/falco-icon-color.svg
  kyverno: https://raw.githubusercontent.com/cncf/artwork/main/projects/kyverno/icon/color/kyverno-icon-color.svg
  kargo: https://raw.githubusercontent.com/akuity/kargo/main/ui/public/kargo-logo-head-only.png
  pyrra: https://raw.githubusercontent.com/pyrra-dev/pyrra/main/ui/public/logo192.png
  volsync: https://raw.githubusercontent.com/backube/volsync/main/docs/media/volsync.svg
}

style.fill: "#0f1410"

classes: {
  card: {
    label.near: bottom-center
    width: 150
    height: 130
    style: {fill: "#191f1a"; stroke: "#2a382c"; font-color: "#e9ebe9"; border-radius: 8; font-size: 14}
  }
  aside: {
    label.near: bottom-center
    width: 150
    height: 130
    style: {fill: "#0f1410"; stroke: "#c09955"; stroke-dash: 4; font-color: "#a1ada3"; border-radius: 8; font-size: 14}
  }
  group: {
    style: {fill: "#0f1410"; stroke: "#2a382c"; font-color: "#a1ada3"; border-radius: 8; font-size: 18}
  }
}

(** -> **)[*].style: {stroke: "#65a16e"; font-color: "#a1ada3"; font-size: 14}

internet: Internet {class: card; icon: ${ify}/tabler/world.svg?color=%23a1ada3&height=64}
github: "GitHub\nrepo, CI" {class: card; icon: ${di}/github-light.svg}
ghcr: "GHCR\nimages" {class: card; icon: ${di}/github-light.svg}
bitwarden: "Bitwarden\nSecrets Manager" {class: card; icon: ${di}/bitwarden.svg}
cloudflare: "Cloudflare\nDNS, proxy" {class: card; icon: ${di}/cloudflare.svg}
letsencrypt: Let's Encrypt {class: card; icon: ${di}/lets-encrypt.svg}
discord: Discord {class: card; icon: ${di}/discord.svg}
pia: PIA VPN {class: card; icon: ${di}/private-internet-access.svg}

edge: Network edge {
  class: group
  grid-rows: 1
  grid-columns: 4
  grid-gap: 16
  modem: "Telia modem\nbridge mode" {class: card; icon: ${ify}/tabler/router.svg?color=%23a1ada3&height=64}
  gw: "UniFi Gateway\nlocal.bigd.no DNS" {class: card; icon: ${di}/unifi.svg}
  sw: UniFi Switch {class: card; icon: ${di}/unifi.svg}
  ap: UniFi U6+ AP {class: card; icon: ${di}/unifi.svg}
}

net: Ingress and cluster networking {
  class: group
  grid-rows: 2
  grid-columns: 3
  grid-gap: 16
  traefik: "Traefik\npublic + private gateway" {class: card; icon: ${di}/traefik.svg}
  cilium: "Cilium\nCNI, L2 VIPs" {class: card; icon: ${di}/cilium.svg}
  cert: cert-manager {class: card; icon: ${di}/cert-manager.svg}
  externaldns: external-dns {class: card; icon: ${di}/kubernetes.svg}
  coredns: CoreDNS {class: card; icon: ${di}/coredns.svg}
  interceptor: "KEDA interceptor\nwake from zero" {class: card; icon: ${di}/keda.svg}
}

ops: GitOps and config {
  class: group
  grid-rows: 2
  grid-columns: 3
  grid-gap: 16
  argocd: Argo CD {class: card; icon: ${di}/argo-cd.svg}
  kargo: Kargo {class: card; icon: ${kargo}}
  rollouts: Argo Rollouts {class: card; icon: ${di}/argo-cd.svg}
  keda: KEDA {class: card; icon: ${di}/keda.svg}
  eso: External Secrets {class: card; icon: ${eso}}
  reloader: Reloader {class: card; icon: ${di}/reloader.svg}
}

sites: Sites and own apps {
  class: group
  grid-rows: 3
  grid-columns: 5
  grid-gap: 16
  portfolio: "Portfolio\nstage + prod" {class: card; icon: ${di}/nextjs-light.svg}
  blog: "Blog\nstage + prod" {class: card; icon: ${di}/hugo.svg}
  bigd: bigd.no {class: card; icon: ${di}/nginx.svg}
  logeverylift: LogEveryLift {class: card; icon: ${ify}/tabler/barbell.svg?color=%23a1ada3&height=64}
  postgres: Postgres 18 {class: card; icon: ${di}/postgresql.svg}
  headroom: "Headroom\n+ demo" {class: card; icon: ${ify}/tabler/wallet.svg?color=%23a1ada3&height=64}
  reelsmith: Reelsmith {class: card; icon: ${ify}/tabler/movie.svg?color=%23a1ada3&height=64}
  verksted: Verksted {class: card; icon: ${ify}/tabler/terminal-2.svg?color=%23a1ada3&height=64}
  trek: Trek {class: card; icon: ${sh}/trek-light.svg}
  homepage: Homepage {class: card; icon: ${sh}/homepage.svg}
  mealie: Mealie {class: card; icon: ${di}/mealie.svg}
  abs: Audiobookshelf {class: card; icon: ${di}/audiobookshelf.svg}
  omnitools: Omni-Tools {class: card; icon: ${ify}/tabler/tools.svg?color=%23a1ada3&height=64}
}

media: Media {
  class: group
  grid-rows: 3
  grid-columns: 5
  grid-gap: 16
  seerr: Seerr {class: card; icon: ${di}/jellyseerr.svg}
  plex: Plex {class: card; icon: ${di}/plex.svg}
  tautulli: Tautulli {class: card; icon: ${di}/tautulli.svg}
  prowlarr: Prowlarr {class: card; icon: ${di}/prowlarr.svg}
  sonarr: Sonarr {class: card; icon: ${di}/sonarr.svg}
  radarr: "Radarr\n+ 4K" {class: card; icon: ${di}/radarr.svg}
  bazarr: "Bazarr\n+ 4K" {class: card; icon: ${di}/bazarr.svg}
  flaresolverr: FlareSolverr {class: card; icon: ${di}/flaresolverr.svg}
  qbit: qBittorrent {class: card; icon: ${di}/qbittorrent.svg}
  gluetun: Gluetun VPN {class: card; icon: ${di}/gluetun.svg}
  unpackerr: Unpackerr {class: card; icon: ${dipng}/unpackerr.png}
  cleanuparr: Cleanuparr {class: card; icon: ${dipng}/cleanuparr.png}
  tdarr: "Tdarr\nQuick Sync" {class: card; icon: ${di}/tdarr.svg}
}

ai: AI {
  class: group
  grid-rows: 1
  grid-columns: 3
  grid-gap: 16
  openwebui: Open WebUI {class: card; icon: ${di}/open-webui-light.svg}
  ollama: Ollama {class: card; icon: ${ify}/simple-icons/ollama.svg?color=%23e9ebe9&height=64}
  innestemme: "Innestemme\nvoice assistant" {class: card; icon: ${ify}/tabler/microphone.svg?color=%23a1ada3&height=64}
}

obs: Observability {
  class: group
  grid-rows: 2
  grid-columns: 5
  grid-gap: 16
  alloy: "Alloy\nlogs, traces" {class: card; icon: ${di}/alloy.svg}
  prometheus: Prometheus {class: card; icon: ${di}/prometheus.svg}
  alertmanager: Alertmanager {class: card; icon: ${di}/alertmanager.svg}
  loki: Loki {class: card; icon: ${di}/loki.svg}
  tempo: Tempo {class: card; icon: ${di}/tempo.svg}
  grafana: Grafana {class: card; icon: ${di}/grafana.svg}
  pyrra: "Pyrra\nSLOs" {class: card; icon: ${pyrra}}
  blackbox: "blackbox\nprobes" {class: card; icon: ${di}/prometheus.svg}
  synthetics: "k6\nsynthetics" {class: card; icon: ${ify}/simple-icons/k6.svg?color=%237d64ff&height=64}
  metrics: metrics-server {class: card; icon: ${di}/kubernetes.svg}
}

sec: Security {
  class: group
  grid-rows: 1
  grid-columns: 4
  grid-gap: 16
  authentik: Authentik {class: card; icon: ${di}/authentik.svg}
  falco: Falco {class: card; icon: ${falco}}
  sidekick: Falcosidekick {class: card; icon: ${falco}}
  kyverno: "Kyverno\naudit policies" {class: card; icon: ${kyverno}}
}

home: Home Assistant box {
  class: group
  grid-rows: 1
  grid-columns: 2
  grid-gap: 16
  ha: Home Assistant {class: card; icon: ${di}/home-assistant.svg}
  adguard: "AdGuard Home\nadd-on" {class: card; icon: ${di}/adguard-home.svg}
}

smart: Smart home devices {
  class: group
  grid-rows: 1
  grid-columns: 5
  grid-gap: 16
  hue: Hue Bridge {class: card; icon: ${sh}/philips-hue.svg}
  zigbee: Zigbee ZBT-2 {class: card; icon: ${di}/zigbee2mqtt.svg}
  ble: BLE proxy {class: card; icon: ${di}/bluetooth.svg}
  voice: Voice PE {class: card; icon: ${ify}/tabler/device-speaker.svg?color=%23a1ada3&height=64}
  cam: UniFi Camera {class: card; icon: ${di}/unifi.svg}
}

store: Storage and backups {
  class: group
  grid-rows: 1
  grid-columns: 4
  grid-gap: 16
  pcsi: "Proxmox CSI\nproxmox-local" {class: card; icon: ${di}/proxmox-light.svg}
  nfscsi: "NFS CSI\nsyno-nfs-csi" {class: card; icon: ${di}/synology.svg}
  volsync: "VolSync\nrestic per PVC" {class: card; icon: ${volsync}}
  etcd: etcd-backup {class: card; icon: ${di}/etcd.svg}
}

hw: Physical hosts {
  class: group
  grid-rows: 1
  grid-columns: 5
  grid-gap: 16
  hyper1: "hyper1\nM70q Gen 2" {class: card; icon: ${di}/proxmox-light.svg}
  hyper2: "hyper2\nM920q" {class: card; icon: ${di}/proxmox-light.svg}
  hyper3: "hyper3\nM920 Tiny" {class: card; icon: ${di}/proxmox-light.svg}
  nas: "Synology DS1522+\nNFS, PBS VM" {class: card; icon: ${di}/synology.svg}
  tailscale: "Tailscale\nsubnet router VM" {class: aside; icon: ${di}/tailscale-light.svg}
}

internet -> cloudflare: HTTPS
cloudflare -> edge: proxied hosts
edge -> net: 80, 443, LAN clients
sec -> net: forward-auth
net -> sites: routes, wake from zero
net -> media: routes
net -> ai: routes, wake from zero
net -> obs: traces, metrics
media -> pia: VPN tunnel
ai -> home: Innestemme actions
home -> smart: Zigbee, BLE, Wi-Fi

github -> ghcr: build, push {style.stroke-dash: 4}
github -> ops: sync main {style.stroke-dash: 4}
ghcr -> ops: new tags {style.stroke-dash: 4}
bitwarden -> ops: secrets {style.stroke-dash: 4}
ops -> net: deploys, Secrets, scaling {style.stroke-dash: 4}
net -> letsencrypt: ACME {style.stroke-dash: 4}
obs -> discord: critical alerts {style.stroke-dash: 4}
sec -> discord: Falco events {style.stroke-dash: 4}

sites -> store: volumes
media -> store: media library
ai -> store: models
store -> hw: NFS, block disks, backups
